{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Search coordination-case history for one or many parcel barcodes.",
  "runLabel": "Run Parcel Log",
  "inputs": [
    {
      "name": "inputMode",
      "label": "Input method",
      "type": "radio-group",
      "default": "single",
      "options": [
        {
          "value": "single",
          "label": "Single barcode"
        },
        {
          "value": "excel",
          "label": "Excel file"
        }
      ]
    },
    {
      "name": "parcelCode",
      "label": "Parcel barcode",
      "type": "text",
      "placeholder": "AMD5652209112754_1",
      "showWhen": {
        "field": "inputMode",
        "equals": "single"
      },
      "requiredWhen": {
        "field": "inputMode",
        "equals": "single"
      }
    },
    {
      "name": "parcelFile",
      "label": "Excel file",
      "type": "file",
      "accept": ".xlsx,.xls,.csv",
      "showWhen": {
        "field": "inputMode",
        "equals": "excel"
      },
      "requiredWhen": {
        "field": "inputMode",
        "equals": "excel"
      },
      "help": "Put parcel barcodes in the first column. Header row is optional."
    }
  ],
  "navigation": {
    "retryCount": 5,
    "retryDelayMs": 500,
    "completeTimeoutMs": 30000
  },
  "successMessage": "Parcel log extracted successfully.",
  "workflow": [
    {
      "action": "open",
      "url": "https://digiexpress.digikala.com/coordination-cases/",
      "active": false,
      "progress": "Opening Parcel Log…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "progress": "Checking authentication…"
    },
    {
      "action": "waitFor",
      "selector": "input[name=\"parcel_code\"][placeholder=\"Barcode\"]",
      "timeoutMs": 20000,
      "progress": "Waiting for barcode search…",
      "error": "Barcode field was not found."
    },
    {
      "action": "fill",
      "selector": "input[name=\"parcel_code\"][placeholder=\"Barcode\"]",
      "value": "{{parcelCode}}",
      "progress": "Entering barcode…"
    },
    {
      "action": "press",
      "selector": "input[name=\"parcel_code\"][placeholder=\"Barcode\"]",
      "key": "Enter",
      "progress": "Searching parcel…"
    },
    {
      "action": "waitFor",
      "selector": "a[href=\"/coordination-cases/\"][uk-close]",
      "timeoutMs": 30000,
      "intervalMs": 250,
      "progress": "Waiting for parcel page to finish loading…",
      "error": "Parcel page did not finish loading after pressing Enter."
    },
    {
      "action": "wait",
      "ms": 500,
      "progress": "Finalizing parcel results…"
    },
    {
      "action": "read",
      "selector": "input[name=\"parcel_code\"][placeholder=\"Barcode\"]",
      "storeAs": "confirmedParcelCode",
      "progress": "Verifying barcode…",
      "error": "Barcode field was not found after search."
    },
    {
      "action": "assert",
      "condition": {
        "left": "{{confirmedParcelCode}}",
        "operator": "contains",
        "right": "{{parcelCode}}"
      },
      "error": "The barcode search was not committed. The barcode field does not contain {{parcelCode}} (current value: {{confirmedParcelCode}})."
    },
    {
      "action": "waitFor",
      "selector": "#tableForm > table.crud-index-table",
      "timeoutMs": 30000,
      "intervalMs": 300,
      "progress": "Waiting for main coordination table…",
      "error": "Main coordination table did not appear after the parcel search loaded."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 30000,
      "stableMs": 1000,
      "pollMs": 300,
      "afterPageMs": 700,
      "dedupe": false,
      "maxPages": 500,
      "pageProgress": "Reading main parcel table page {{page}}…",
      "progress": "Extracting main parcel history…",
      "parser": {
        "tableSelector": "#tableForm > table.crud-index-table",
        "rowSelector": ":scope > tbody > tr.crud-index-table__row",
        "headerSelector": ":scope > thead > tr > th"
      }
    },
    {
      "action": "closeTab",
      "progress": "Closing Parcel Log tab…"
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 1200
  },
  "clientProcessor": {
    "type": "batch-data-pipeline",
    "modeField": "inputMode",
    "singleMode": "single",
    "singleField": "parcelCode",
    "fileField": "parcelFile",
    "sourceOperationId": "parcel-log",
    "sourceInputName": "parcelCode",
    "inputLabel": "Barcode",
    "resultColumns": [
      {
        "header": "barcode",
        "aliases": [
          "barcode",
          "parcel code",
          "parcel_code"
        ]
      },
      {
        "header": "coordination status",
        "aliases": [
          "coordination status",
          "status"
        ]
      },
      {
        "header": "reason",
        "aliases": [
          "reason"
        ]
      },
      {
        "header": "updated at",
        "aliases": [
          "updated at",
          "updated_at"
        ]
      }
    ],
    "presentation": {
      "title": "Parcel Log Report",
      "dashboardTitle": "Parcel Log Dashboard",
      "downloadButtonLabel": "Download Excel",
      "openDashboardLabel": "Open Dashboard",
      "table": {
        "enabled": true
      }
    },
    "export": {
      "enabled": true,
      "buttonLabel": "Download Excel",
      "filename": "parcel_log_report.xlsx",
      "sheetName": "Parcel Log",
      "saveAs": false
    }
  },
  "runtimeContract": "stable-host-12",
  "businessLogicOwner": "remote"
}