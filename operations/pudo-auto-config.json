{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "requiredHosts": [
    "https://drop-shipping.digikala.com/*",
    "https://sso.digikala.com/*",
    "https://auth.mydigikala.com/*"
  ],
  "description": "Upload the five-column PUDO template and create Drop Shipping batch configurations row by row. Parent selection uses Parent Code.",
  "runLabel": "Start PUDO Auto Config",
  "inputs": [
    {
      "name": "templateDownload",
      "label": "PUDO Auto Config Template",
      "type": "download",
      "buttonLabel": "Download Template",
      "asset": "templates/PUDO_Auto_Config_Template.xlsx",
      "filename": "PUDO_Auto_Config_Template.xlsx",
      "help": "Template columns: نام مرکز، نام پرنت، کد پرنت، تاریخ شروع، تاریخ پایان."
    },
    {
      "name": "pudoFile",
      "label": "PUDO configuration Excel",
      "type": "file",
      "accept": ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "required": true,
      "help": "Use the five-column template. Parent is selected by کد پرنت. Jalali dates: YYYYMMDD or YYYY/MM/DD."
    }
  ],
  "clientProcessor": {
    "type": "excel-batch-workflow",
    "fileField": "pudoFile",
    "maxRetries": 3,
    "retryDelayMs": 1800,
    "columnMap": {
      "centerName": {
        "headers": [
          "نام مرکز",
          "Center Name",
          "Center",
          "مرکز"
        ],
        "index": 0
      },
      "parentName": {
        "headers": [
          "نام پرنت",
          "Parent Name",
          "Parent"
        ],
        "index": 1
      },
      "parentCode": {
        "headers": [
          "کد پرنت",
          "Parent Code",
          "Parent ID",
          "Parent Code / ID"
        ],
        "index": 2
      },
      "startDate": {
        "headers": [
          "تاریخ شروع",
          "Start Date",
          "From Date"
        ],
        "index": 3
      },
      "endDate": {
        "headers": [
          "تاریخ پایان",
          "End Date",
          "To Date"
        ],
        "index": 4
      }
    },
    "validation": {
      "required": [
        "centerName",
        "parentCode",
        "startDate",
        "endDate"
      ],
      "labels": {
        "centerName": "نام مرکز",
        "parentName": "نام پرنت",
        "parentCode": "کد پرنت",
        "startDate": "تاریخ شروع",
        "endDate": "تاریخ پایان"
      }
    },
    "result": {
      "resultColumn": "Result",
      "successText": "Done",
      "downloadButtonLabel": "Download Result",
      "sheetName": "PUDO Auto Config Results",
      "filename": "pudo_auto_config_result_{{timestamp}}.xlsx",
      "successFill": "C6EFCE",
      "failureFill": "FFC7CE",
      "notProcessedText": "Not processed (cancelled)",
      "confirmationText": "Done!!!!",
      "repeatUntilConfirmation": false
    },
    "tabSession": {
      "enabled": true,
      "background": true,
      "reuseForBatch": true,
      "closeOnFinish": false,
      "closeOnCancel": false
    },
    "liveReport": {
      "enabled": true,
      "itemLabel": "centers",
      "autoScroll": true,
      "maxHeight": 360,
      "columns": [
        {
          "header": "نام مرکز",
          "field": "centerName"
        },
        {
          "header": "نام پرنت",
          "field": "parentName"
        },
        {
          "header": "وضعیت",
          "result": true,
          "successText": "Success",
          "failureText": "Failed"
        },
        {
          "header": "جزئیات",
          "resultMessage": true
        }
      ]
    }
  },
  "navigation": {
    "retryCount": 8,
    "retryDelayMs": 400,
    "completeTimeoutMs": 30000
  },
  "successMessage": "Done",
  "workflow": [
    {
      "action": "open",
      "url": "https://drop-shipping.digikala.com/batch-configs",
      "active": false,
      "progress": "Opening PUDO Batch Config…",
      "completeTimeoutMs": 30000
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "progress": "Checking authentication…"
    },
    {
      "action": "navigate",
      "url": "https://drop-shipping.digikala.com/batch-configs",
      "progress": "Opening Batch Config form…",
      "completeTimeoutMs": 30000
    },
    {
      "action": "waitFor",
      "selector": "input.uk-select.es-input",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "progress": "Waiting for PUDO configuration form…",
      "error": "PUDO configuration fields were not found."
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input",
      "value": "{{parentCode}}",
      "attempts": 3,
      "verifyNonEmpty": true,
      "progress": "Selecting parent code: {{parentCode}}…",
      "error": "Parent could not be selected using Parent Code.",
      "options": {
        "selectorIndex": 0,
        "focusWaitMs": 400,
        "typingDelayMs": 70,
        "autocompleteWaitMs": 1800,
        "pressEnter": true,
        "commitWaitMs": 1100,
        "outsideWaitMs": 350
      }
    },
    {
      "action": "wait",
      "ms": 500,
      "progress": "Waiting for parent selection…"
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input",
      "value": "{{centerName}}",
      "attempts": 4,
      "verifyNonEmpty": true,
      "progress": "Selecting center: {{centerName}}…",
      "error": "Center could not be selected from the suggestions.",
      "options": {
        "selectorIndex": 1,
        "focusWaitMs": 400,
        "typingDelayMs": 70,
        "autocompleteWaitMs": 2200,
        "commitWaitMs": 1400,
        "outsideWaitMs": 500,
        "pressEnter": true,
        "keyDelayMs": 120
      },
      "retryDelayMs": 700
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-from_date, input[data-name=\"from_date\"]",
      "value": "{{startDate}}",
      "progress": "Setting start date: {{startDate}}…",
      "error": "Start Date could not be entered.",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 700,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 450
      }
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-to_date, input[data-name=\"to_date\"]",
      "value": "{{endDate}}",
      "progress": "Setting end date: {{endDate}}…",
      "error": "End Date could not be entered.",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 700,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 500
      }
    },
    {
      "action": "click",
      "selector": "button.uk-button.uk-button-primary",
      "textContains": "Add Batch Config",
      "progress": "Submitting batch configuration…",
      "error": "Add Batch Config button could not be clicked."
    },
    {
      "action": "read",
      "selector": "body",
      "storeAs": "pudoAfterSubmit0",
      "required": true,
      "progress": "Checking save confirmation…"
    },
    {
      "action": "wait",
      "ms": 250
    },
    {
      "action": "read",
      "selector": "body",
      "storeAs": "pudoAfterSubmit1",
      "required": true
    },
    {
      "action": "wait",
      "ms": 450
    },
    {
      "action": "read",
      "selector": "body",
      "storeAs": "pudoAfterSubmit2",
      "required": true
    },
    {
      "action": "setContext",
      "name": "pudoConfirmationText",
      "value": "{{pudoAfterSubmit0}} {{pudoAfterSubmit1}} {{pudoAfterSubmit2}}"
    },
    {
      "action": "assert",
      "condition": {
        "left": "{{pudoConfirmationText}}",
        "operator": "contains",
        "right": "Done!!!!"
      },
      "error": "PUDO save confirmation Done!!!! was not observed. The row will be retried."
    }
  ],
  "runtimeContract": "stable-host-12",
  "businessLogicOwner": "remote"
}
