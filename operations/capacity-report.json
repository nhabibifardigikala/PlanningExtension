{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Search for a Distribution Center by name and select it, then enter a Jalali date range.",
  "runLabel": "Run capacity report",
  "inputs": [
    {
      "name": "dcId",
      "label": "Distribution Center",
      "type": "remote-autocomplete",
      "required": true,
      "placeholder": "Type a distribution center name…",
      "minChars": 2,
      "debounceMs": 500,
      "maxResults": 500,
      "showId": true,
      "selectionMessage": "Please select a Distribution Center from the search results.",
      "help": "Type at least 2 characters. Matching centers are ranked by similarity. The center list is cached to reduce Google Sheet requests.",
      "source": {
        "format": "csv",
        "url": "https://docs.google.com/spreadsheets/d/1eOeX-rXyNycXAyCYCHlH8UgW-NkyQ4IsbBOG0iQaB7k/gviz/tq?tqx=out:csv&sheet=Distribution%20Centers%20(LG)",
        "cacheMs": 3600000,
        "nameColumns": [
          "Name",
          "Distribution Center Name",
          "DC Name",
          "distribution center name",
          "name"
        ],
        "idColumns": [
          "id"
        ],
        "idColumn": "id"
      }
    },
    {
      "name": "fromDate",
      "label": "From date (Jalali)",
      "type": "jalali-date",
      "required": true,
      "placeholder": "14050501",
      "maxLength": 8,
      "pattern": "^\\d{8}$",
      "validationMessage": "From date must contain exactly 8 digits."
    },
    {
      "name": "toDate",
      "label": "To date (Jalali)",
      "type": "jalali-date",
      "required": true,
      "placeholder": "14050531",
      "maxLength": 8,
      "pattern": "^\\d{8}$",
      "validationMessage": "To date must contain exactly 8 digits."
    }
  ],
  "navigation": {
    "retryCount": 10,
    "retryDelayMs": 400,
    "completeTimeoutMs": 30000
  },
  "successMessage": "Done. {{rowCount}} rows exported.",
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/dc-capacity/",
      "progress": "Opening Capacity Report…",
      "active": true
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "progress": "Checking authentication…"
    },
    {
      "action": "waitFor",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "progress": "Waiting for report form…",
      "error": "Distribution Center field was not found."
    },
    {
      "action": "autocomplete",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "value": "{{dcId}}",
      "attempts": 5,
      "verifyNonEmpty": true,
      "retryDelayMs": 600,
      "progress": "Setting Distribution Center…",
      "options": {
        "typingDelayMs": 140,
        "autocompleteWaitMs": 1800,
        "pressEnter": true,
        "commitWaitMs": 1200,
        "outsideSelector": "#form-field-from, #form-field-from_date, input[data-name=\"from_date\"]",
        "outsideWaitMs": 900
      }
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-from, #form-field-from_date, input[data-name=\"from_date\"], input[placeholder=\"from Date\"]",
      "value": "{{fromDate}}",
      "progress": "Setting start date…",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 1000,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 500
      }
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-to, #form-field-to_date, input[data-name=\"to_date\"], input[placeholder=\"to Date\"]",
      "value": "{{toDate}}",
      "progress": "Setting end date…",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 1000,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 700
      }
    },
    {
      "action": "clickAndWait",
      "selector": "button.uk-button.uk-button-primary[type=\"submit\"]",
      "textContains": "search",
      "successSelector": "a[href=\"/dc-capacity/\"].uk-button.uk-button-gray",
      "attempts": 3,
      "timeoutMs": 60000,
      "intervalMs": 250,
      "progress": "Searching and waiting for results…",
      "error": "Search did not complete: CLEAR button did not appear."
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 30000,
      "intervalMs": 500,
      "progress": "Waiting for capacity rows…",
      "error": "No capacity results appeared."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 30000,
      "stableMs": 1800,
      "pollMs": 450,
      "afterPageMs": 1200,
      "dedupe": false,
      "maxPages": 1000,
      "pageProgress": "Extracting capacity page {{page}}…",
      "progress": "Extracting capacity data…"
    },
    {
      "action": "calculateStats",
      "progress": "Calculating statistics…",
      "fields": {
        "days": {
          "type": "jalaliRangeDays",
          "from": "{{fromDate}}",
          "to": "{{toDate}}"
        },
        "capacity": {
          "type": "column",
          "aliases": [
            "capacity"
          ]
        },
        "reserved": {
          "type": "column",
          "aliases": [
            "capacity reserved",
            "reserved capacity",
            "capacity_reserved"
          ]
        }
      }
    },
    {
      "action": "exportExcel",
      "sheetName": "Capacity Report",
      "filename": "Capacity_DC{{dcId}}_{{fromDate}}_{{toDate}}.xlsx",
      "progress": "Creating Excel file…"
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 1500
  }
}