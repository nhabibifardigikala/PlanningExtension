{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Select one or more Distribution Centers by name and choose the Jalali date range.",
  "runLabel": "Run capacity report",
  "inputs": [
    {
      "name": "dcIds",
      "label": "Distribution Centers",
      "type": "remote-multi-autocomplete",
      "required": true,
      "placeholder": "Type a center name and press Enter…",
      "minChars": 2,
      "debounceMs": 500,
      "maxResults": 500,
      "showId": true,
      "selectionMessage": "Select at least one Distribution Center from the list.",
      "help": "Type a center name, use ↑/↓ to move through results and Enter to add it. Repeat to add more centers.",
      "source": {
        "format": "csv",
        "url": "https://docs.google.com/spreadsheets/d/1eOeX-rXyNycXAyCYCHlH8UgW-NkyQ4IsbBOG0iQaB7k/gviz/tq?sheet=Distribution%20Centers%20(LG)&headers=3&tqx=out:csv&tq=select%20A%2CB%20label%20A%20%27id%27%2CB%20%27name%27",
        "cacheMs": 3600000,
        "nameColumns": [
          "name"
        ],
        "idColumns": [
          "id"
        ],
        "idColumn": "id",
        "nameColumn": "name"
      },
      "showSelectedId": false
    },
    {
      "name": "fromDate",
      "label": "From date (Jalali)",
      "type": "jalali-date",
      "required": true,
      "placeholder": "14050520",
      "maxLength": 8,
      "pattern": "^\\d{8}$",
      "validationMessage": "From date must contain exactly 8 digits.",
      "picker": true,
      "help": "Type 8 digits or use the Persian date picker."
    },
    {
      "name": "toDate",
      "label": "To date (Jalali)",
      "type": "jalali-date",
      "required": true,
      "placeholder": "14050520",
      "maxLength": 8,
      "pattern": "^\\d{8}$",
      "validationMessage": "To date must contain exactly 8 digits.",
      "picker": true,
      "help": "Type 8 digits or use the Persian date picker."
    }
  ],
  "navigation": {
    "retryCount": 10,
    "retryDelayMs": 400,
    "completeTimeoutMs": 30000
  },
  "successMessage": "Capacity report completed.",
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/dc-capacity/",
      "progress": "Opening Capacity Report…",
      "active": false
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "progress": "Checking authentication…"
    },
    {
      "action": "waitFor",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "progress": "Waiting for report form…",
      "error": "Distribution Center field was not found."
    },
    {
      "action": "wait",
      "ms": 900,
      "progress": "Preparing Distribution Center field…"
    },
    {
      "action": "fill",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "value": "{{dcId}}",
      "progress": "Setting Distribution Centers…",
      "error": "Could not set Distribution Center IDs."
    },
    {
      "action": "wait",
      "ms": 1200,
      "progress": "Waiting after Distribution Center IDs…"
    },
    {
      "action": "clickOutside",
      "center": true,
      "progress": "Applying Distribution Centers…"
    },
    {
      "action": "wait",
      "ms": 900,
      "progress": "Waiting for Distribution Centers…"
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-from, #form-field-from_date, input[data-name=\"from_date\"], input[placeholder=\"from Date\"]",
      "value": "{{fromDate}}",
      "progress": "Setting start date…",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 1000,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 500
      }
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-to, #form-field-to_date, input[data-name=\"to_date\"], input[placeholder=\"to Date\"]",
      "value": "{{toDate}}",
      "progress": "Setting end date…",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 1000,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 700
      }
    },
    {
      "action": "clickAndWait",
      "selector": "button.uk-button.uk-button-primary[type=\"submit\"]",
      "textContains": "search",
      "successSelector": "a[href=\"/dc-capacity/\"].uk-button.uk-button-gray",
      "attempts": 3,
      "timeoutMs": 60000,
      "intervalMs": 250,
      "progress": "Searching and waiting for results…",
      "error": "Search did not complete: CLEAR button did not appear."
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 30000,
      "intervalMs": 500,
      "progress": "Waiting for capacity rows…",
      "error": "No capacity results appeared."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 30000,
      "stableMs": 1800,
      "pollMs": 450,
      "afterPageMs": 1200,
      "dedupe": false,
      "maxPages": 1000,
      "pageProgress": "Extracting capacity page {{page}}…",
      "progress": "Extracting capacity data…"
    },
    {
      "action": "calculateStats",
      "progress": "Calculating statistics…",
      "fields": {
        "days": {
          "type": "jalaliRangeDays",
          "from": "{{fromDate}}",
          "to": "{{toDate}}"
        },
        "capacity": {
          "type": "column",
          "aliases": [
            "capacity"
          ]
        },
        "reserved": {
          "type": "column",
          "aliases": [
            "capacity reserved",
            "reserved capacity",
            "capacity_reserved"
          ]
        }
      }
    },
    {
      "action": "closeTab",
      "progress": "Closing report tab…"
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 1500
  },
  "clientProcessor": {
    "type": "data-pipeline",
    "source": {
      "type": "remote-operation",
      "operationId": "capacity-report",
      "inputs": {
        "dcId": {
          "from": "dcIds",
          "transform": "joinSelectionIds",
          "separator": " "
        },
        "dcName": {
          "from": "dcIds",
          "transform": "joinSelectionNames",
          "separator": " | "
        },
        "fromDate": {
          "from": "fromDate"
        },
        "toDate": {
          "from": "toDate"
        }
      },
      "status": "Running one capacity query for {{count:dcIds}} Distribution Centers…"
    },
    "partition": {
      "byInput": "dcIds",
      "itemId": "id",
      "itemLabel": "name",
      "rowIdAliases": [
        "distribution center id",
        "dc id",
        "distribution_center_id",
        "distribution center"
      ],
      "rowLabelAliases": [
        "distribution center",
        "distribution center name",
        "dc name",
        "dc"
      ],
      "allowRowScanFallback": true,
      "unmatchedPolicy": "exclude"
    },
    "groups": [
      {
        "fieldAliases": [
          "time scope",
          "time_scope",
          "timescope",
          "time slot",
          "time_slot"
        ],
        "label": "Time Scope",
        "fallbackLabel": "All"
      }
    ],
    "metrics": [
      {
        "id": "days",
        "label": "Report days",
        "type": "distinctCount",
        "fieldAliases": [
          "date",
          "day",
          "capacity date",
          "تاریخ"
        ]
      },
      {
        "id": "capacity",
        "label": "Capacity",
        "type": "numberSummary",
        "fieldAliases": [
          "capacity"
        ],
        "stats": [
          "min",
          "avg",
          "max"
        ]
      },
      {
        "id": "reserved",
        "label": "Capacity Reserved",
        "type": "numberSummary",
        "fieldAliases": [
          "capacity reserved",
          "reserved capacity",
          "capacity_reserved"
        ],
        "stats": [
          "min",
          "avg",
          "max"
        ]
      }
    ],
    "charts": [
      {
        "type": "line",
        "title": "",
        "x": {
          "fieldAliases": [
            "date",
            "day",
            "capacity date",
            "تاریخ"
          ],
          "label": "Date",
          "verticalLabels": true
        },
        "series": [
          {
            "id": "capacity",
            "label": "Capacity",
            "fieldAliases": [
              "capacity"
            ]
          },
          {
            "id": "reserved",
            "label": "Capacity Reserved",
            "fieldAliases": [
              "capacity reserved",
              "reserved capacity",
              "capacity_reserved"
            ]
          }
        ],
        "pointSpacing": 29,
        "fillAvailable": true,
        "horizontalScroll": true,
        "tooltip": true
      }
    ],
    "presentation": {
      "partitionTitle": "{{partition.label}}",
      "partitionSubtitle": "ID {{partition.id}} • {{groupCount}} Time Scope{{groupCountPlural}}",
      "groupTitle": "{{group.label}}",
      "dashboardButtonLabel": "Open dashboard",
      "dashboardTitle": "Capacity Dashboard",
      "downloadButtonLabel": "Download Excel",
      "metricLayout": "blocks"
    },
    "export": {
      "enabled": true,
      "type": "xlsx",
      "buttonLabel": "Download Excel",
      "filename": "capacity_report_{{fromDate}}_{{toDate}}.xlsx",
      "sheetName": "Capacity Report",
      "saveAs": false,
      "prependColumns": [
        {
          "header": "Distribution Center",
          "value": "{{partition.label}}"
        },
        {
          "header": "Distribution Center ID",
          "value": "{{partition.id}}"
        },
        {
          "header": "From Date",
          "value": "{{input.fromDate}}"
        },
        {
          "header": "To Date",
          "value": "{{input.toDate}}"
        }
      ]
    }
  },
  "remoteBehaviorVersion": 1
}
