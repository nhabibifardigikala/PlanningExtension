{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Remote-owned Capacity Report with DK and Flex sources. DK runs each selected center independently in a background tab, forces 1000-row paging before filters, and can aggregate across centers and time scopes. Flex runs each selected center independently and charts Shipping Reserved Capacity by Date per Time Slot.",
  "runLabel": "Open Capacity Report",
  "inputs": [
    {
      "name": "__capacityReportEmbedded",
      "label": "",
      "type": "text",
      "showWhen": {
        "field": "__never__",
        "equals": "true"
      }
    }
  ],
  "navigation": {
    "retryCount": 10,
    "retryDelayMs": 400,
    "completeTimeoutMs": 30000
  },
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/dc-capacity/?per_page=1000",
      "active": false,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Opening DK Capacity Report…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Checking DK authentication…"
    },
    {
      "action": "navigate",
      "url": "https://lg.digikala.com/dc-capacity/?per_page=1000",
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Setting DK rows per page to 1000…"
    },
    {
      "action": "waitFor",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "error": "DK Distribution Center field was not found."
    },
    {
      "action": "autocomplete",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "value": "{{dcId}}",
      "attempts": 5,
      "options": {
        "focusWaitMs": 450,
        "clearWaitMs": 250,
        "typingDelayMs": 110,
        "autocompleteWaitMs": 1800,
        "pressEnter": true,
        "keyDelayMs": 90,
        "commitWaitMs": 1200,
        "outsideSelector": "#form-field-from, #form-field-from_date, input[data-name=\"from_date\"]",
        "outsideWaitMs": 700,
        "selectorIndex": 0
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Selecting DK Distribution Center in background…",
      "error": "Could not select the DK Distribution Center in the background tab."
    },
    {
      "action": "read",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "storeAs": "dcFieldValue",
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "error": "DK Distribution Center field was not found."
    },
    {
      "action": "assert",
      "condition": {
        "left": "{{dcFieldValue}}",
        "operator": "truthy"
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "error": "DK Distribution Center values were not committed."
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-from, #form-field-from_date, input[data-name=\"from_date\"], input[placeholder=\"from Date\"]",
      "value": "{{fromDate}}",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 900,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 450
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Setting DK start date…"
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-to, #form-field-to_date, input[data-name=\"to_date\"], input[placeholder=\"to Date\"]",
      "value": "{{toDate}}",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 900,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 650
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Setting DK end date…"
    },
    {
      "action": "submitNearestForm",
      "selector": "button.uk-button.uk-button-primary[type=\"submit\"]",
      "waitForNavigation": true,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Submitting DK search from the background tab…",
      "error": "DK Capacity Report search could not be submitted.",
      "completeTimeoutMs": 60000,
      "options": {
        "submitMode": "native-form",
        "submitSelector": "button.uk-button.uk-button-primary[type=\"submit\"]",
        "hiddenFields": {
          "per_page": "1000"
        }
      }
    },
    {
      "action": "waitFor",
      "selector": "a[href=\"/dc-capacity/\"].uk-button.uk-button-gray",
      "timeoutMs": 60000,
      "intervalMs": 250,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Waiting for DK results…",
      "error": "DK Capacity search did not complete."
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 30000,
      "intervalMs": 400,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "error": "No DK capacity rows appeared."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 30000,
      "stableMs": 1500,
      "pollMs": 400,
      "afterPageMs": 1000,
      "dedupe": false,
      "maxPages": 1000,
      "pageProgress": "Extracting DK capacity page {{page}}…",
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Extracting DK capacity data…"
    },
    {
      "action": "closeTab",
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Closing DK report tab…"
    },
    {
      "action": "open",
      "url": "https://flex.digikala.com/hubs/capacity-slots/",
      "active": false,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Opening Flex Capacity Report…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Checking Flex authentication…"
    },
    {
      "action": "navigate",
      "url": "https://flex.digikala.com/hubs/capacity-slots/",
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Opening Flex capacity slots…"
    },
    {
      "action": "waitFor",
      "selector": "input.uk-select.es-input[placeholder=\"Hub Coverage Polygons\"]",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "error": "Flex Distribution Center field was not found."
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input[placeholder=\"Hub Coverage Polygons\"]",
      "value": "{{flexDcName}}",
      "attempts": 3,
      "options": {
        "focusWaitMs": 500,
        "typingDelayMs": 45,
        "autocompleteWaitMs": 1100,
        "pressEnter": true,
        "commitWaitMs": 900,
        "outsideWaitMs": 350,
        "selectorIndex": 0
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Selecting the closest Flex Distribution Center…",
      "error": "Could not select the Flex Distribution Center."
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-from_date, input[data-name=\"from_date\"]",
      "value": "{{fromDate}}",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 700,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 400
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Setting Flex start date…"
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-to_date, input[data-name=\"to_date\"]",
      "value": "{{toDate}}",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 700,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 500
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Setting Flex end date…"
    },
    {
      "action": "submitNearestForm",
      "selector": "button.uk-button.uk-button-primary[type=\"submit\"]",
      "waitForNavigation": false,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Searching Flex Capacity Report…",
      "error": "Flex Capacity Report search could not be submitted."
    },
    {
      "action": "wait",
      "ms": 1600,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Waiting for Flex results…"
    },
    {
      "action": "waitFor",
      "selector": "table:has(thead th[data-code=\"coverage_polygon\"]):has(thead th[data-code=\"time_slot\"]) tbody tr",
      "timeoutMs": 45000,
      "intervalMs": 400,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "error": "No Flex capacity rows appeared in the capacity-slots result table."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"], a[rel=\"next\"], .uk-pagination-next a",
      "timeoutMs": 30000,
      "stableMs": 1400,
      "pollMs": 400,
      "afterPageMs": 900,
      "dedupe": false,
      "maxPages": 1000,
      "pageProgress": "Extracting Flex capacity page {{page}}…",
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Extracting Flex shipping reserved capacity…",
      "parser": {
        "tableSelector": "table:has(thead th[data-code=\"coverage_polygon\"]):has(thead th[data-code=\"time_slot\"])",
        "headerSelector": "thead th",
        "rowSelector": "tbody tr",
        "svgBoolean": false
      },
      "error": "Flex capacity rows could not be extracted from the capacity-slots result table."
    },
    {
      "action": "closeTab",
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Closing Flex report tab…"
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 1200
  },
  "successMessage": "Capacity report data extracted.",
  "runtimeContract": "stable-host-12",
  "businessLogicOwner": "remote",
  "remoteBehaviorVersion": 4
}
