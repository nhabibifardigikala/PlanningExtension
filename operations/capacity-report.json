{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Remote-owned Capacity Report. DK searches each selected Distribution Center by its exact numeric ID, runs in a background tab with 1000-row paging, and can aggregate across centers/time scopes. Flex supports multiple centers and can select Hub Coverage Polygons either by visible center name or by the numeric Flex option ID shown in brackets.",
  "runLabel": "Open Capacity Report",
  "inputs": [
    {
      "name": "__capacityReportEmbedded",
      "label": "",
      "type": "text",
      "showWhen": {
        "field": "__never__",
        "equals": "true"
      }
    }
  ],
  "navigation": {
    "retryCount": 10,
    "retryDelayMs": 400,
    "completeTimeoutMs": 30000
  },
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/dc-capacity/?per_page=1000",
      "active": false,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Opening DK Capacity Report…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Checking DK authentication…"
    },
    {
      "action": "navigate",
      "url": "https://lg.digikala.com/dc-capacity/?per_page=1000",
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Setting DK rows per page to 1000…"
    },
    {
      "action": "waitFor",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "error": "DK Distribution Center field was not found."
    },
    {
      "action": "autocomplete",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "value": "{{dcId}}",
      "attempts": 3,
      "options": {
        "focusWaitMs": 450,
        "clearWaitMs": 250,
        "typingDelayMs": 90,
        "autocompleteWaitMs": 1400,
        "pressEnter": true,
        "keyDelayMs": 80,
        "commitWaitMs": 1000,
        "outsideSelector": "#form-field-from, #form-field-from_date, input[data-name=\"from_date\"]",
        "outsideWaitMs": 550,
        "selectorIndex": 0
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Selecting DK Distribution Center by ID…",
      "error": "Could not select the DK Distribution Center by its numeric ID."
    },
    {
      "action": "read",
      "selector": "input.es-input[placeholder=\"Distribution center\"]",
      "storeAs": "dcFieldValue",
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "error": "DK Distribution Center field was not found."
    },
    {
      "action": "assert",
      "condition": {
        "left": "{{dcFieldValue}}",
        "operator": "truthy"
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "error": "DK Distribution Center values were not committed."
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-from, #form-field-from_date, input[data-name=\"from_date\"], input[placeholder=\"from Date\"]",
      "value": "{{fromDate}}",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 900,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 450
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Setting DK start date…"
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-to, #form-field-to_date, input[data-name=\"to_date\"], input[placeholder=\"to Date\"]",
      "value": "{{toDate}}",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 900,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 650
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Setting DK end date…"
    },
    {
      "action": "submitNearestForm",
      "selector": "button.uk-button.uk-button-primary[type=\"submit\"]",
      "waitForNavigation": false,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Submitting DK search in the background…",
      "error": "DK Capacity Report search could not be submitted.",
      "completeTimeoutMs": 30000,
      "options": {
        "submitMode": "native-form",
        "submitSelector": "button.uk-button.uk-button-primary[type=\"submit\"]",
        "hiddenFields": {
          "per_page": "1000"
        }
      },
      "stepAttempts": 1
    },
    {
      "action": "wait",
      "ms": 1200,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Waiting for DK result page…"
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 60000,
      "intervalMs": 350,
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "error": "DK search completed but no capacity rows were available for the selected Distribution Center/date range.",
      "stepAttempts": 1,
      "progress": "Waiting for DK capacity rows…"
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 30000,
      "stableMs": 900,
      "pollMs": 300,
      "afterPageMs": 700,
      "dedupe": false,
      "maxPages": 1000,
      "pageProgress": "Extracting DK capacity page {{page}}…",
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Extracting DK capacity data…",
      "expectedRowsPerPage": 1000,
      "allowLastPagePartial": true,
      "stepAttempts": 1
    },
    {
      "action": "closeTab",
      "when": {
        "left": "{{reportSource}}",
        "equals": "dk"
      },
      "progress": "Closing DK report tab…"
    },
    {
      "action": "open",
      "url": "https://flex.digikala.com/hubs/capacity-slots/",
      "active": true,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Opening Flex Capacity Report for exact center selection…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Checking Flex authentication…"
    },
    {
      "action": "navigate",
      "url": "https://flex.digikala.com/hubs/capacity-slots/",
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Opening Flex capacity slots…"
    },
    {
      "action": "waitFor",
      "selector": "input.uk-select.es-input[placeholder=\"Hub Coverage Polygons\"]",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "error": "Flex Distribution Center field was not found."
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input[placeholder=\"Hub Coverage Polygons\"]",
      "value": "{{flexDcName}}",
      "attempts": 1,
      "options": {
        "focusWaitMs": 700,
        "clearWaitMs": 300,
        "typingDelayMs": 80,
        "autocompleteWaitMs": 3000,
        "commitWaitMs": 900,
        "outsideWaitMs": 350,
        "selectorIndex": 0,
        "exactMatch": true,
        "exactMatchSelector": ".es-list li",
        "exactMatchTimeoutMs": 10000,
        "verifyExactValue": true,
        "matchTransforms": [
          {
            "type": "normalizeUnicode",
            "form": "NFKC"
          },
          {
            "type": "regexReplace",
            "pattern": "[\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]",
            "flags": "g",
            "replacement": ""
          },
          {
            "type": "regexReplace",
            "pattern": "^\\s*\\[[^\\]]+\\]\\s*",
            "flags": "g",
            "replacement": ""
          },
          {
            "type": "regexReplace",
            "pattern": "[يى]",
            "flags": "g",
            "replacement": "ی"
          },
          {
            "type": "regexReplace",
            "pattern": "ك",
            "flags": "g",
            "replacement": "ک"
          },
          "collapseWhitespace",
          "trim",
          "caseFold"
        ]
      },
      "when": {
        "left": "{{flexSelectionMode}}",
        "equals": "name"
      },
      "progress": "Selecting the exact Flex center by name…",
      "error": "The exact Flex Distribution Center name could not be selected from Hub Coverage Polygons. You can use the numeric Flex ID instead.",
      "stepAttempts": 1,
      "retry": false
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input[placeholder=\"Hub Coverage Polygons\"]",
      "value": "{{flexDcId}}",
      "attempts": 1,
      "options": {
        "focusWaitMs": 700,
        "clearWaitMs": 300,
        "typingDelayMs": 80,
        "autocompleteWaitMs": 2200,
        "commitWaitMs": 900,
        "outsideWaitMs": 350,
        "selectorIndex": 0,
        "exactMatch": true,
        "exactMatchSelector": ".es-list li",
        "exactMatchTimeoutMs": 10000,
        "verifyExactValue": false,
        "matchTransforms": [
          {
            "type": "normalizeUnicode",
            "form": "NFKC"
          },
          {
            "type": "regexReplace",
            "pattern": "[\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]",
            "flags": "g",
            "replacement": ""
          },
          {
            "type": "regexReplace",
            "pattern": "^\\s*\\[([^\\]]+)\\].*$",
            "flags": "g",
            "replacement": "$1"
          },
          "collapseWhitespace",
          "trim",
          "caseFold"
        ]
      },
      "when": {
        "left": "{{flexSelectionMode}}",
        "equals": "id"
      },
      "progress": "Selecting the Flex center by numeric ID…",
      "error": "The Flex Distribution Center ID was not found in Hub Coverage Polygons.",
      "stepAttempts": 1,
      "retry": false
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-from_date, input[data-name=\"from_date\"]",
      "value": "{{fromDate}}",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 700,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 400
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Setting Flex start date…"
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-to_date, input[data-name=\"to_date\"]",
      "value": "{{toDate}}",
      "options": {
        "slashFormat": true,
        "waitBeforeOutsideMs": 700,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 500
      },
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Setting Flex end date…"
    },
    {
      "action": "submitNearestForm",
      "selector": "button.uk-button.uk-button-primary[type=\"submit\"]",
      "waitForNavigation": false,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Searching Flex Capacity Report…",
      "error": "Flex Capacity Report search could not be submitted."
    },
    {
      "action": "wait",
      "ms": 1600,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Waiting for Flex results…"
    },
    {
      "action": "waitFor",
      "selector": "table:has(thead th[data-code=\"coverage_polygon\"]):has(thead th[data-code=\"time_slot\"]) tbody tr",
      "timeoutMs": 45000,
      "intervalMs": 400,
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "error": "No Flex capacity rows appeared in the capacity-slots result table."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"], a[rel=\"next\"], .uk-pagination-next a",
      "timeoutMs": 30000,
      "stableMs": 1400,
      "pollMs": 400,
      "afterPageMs": 900,
      "dedupe": false,
      "maxPages": 1000,
      "pageProgress": "Extracting Flex capacity page {{page}}…",
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Extracting Flex shipping reserved capacity…",
      "parser": {
        "tableSelector": "table:has(thead th[data-code=\"coverage_polygon\"]):has(thead th[data-code=\"time_slot\"])",
        "headerSelector": "thead th",
        "rowSelector": "tbody tr",
        "svgBoolean": false
      },
      "error": "Flex capacity rows could not be extracted from the capacity-slots result table."
    },
    {
      "action": "closeTab",
      "when": {
        "left": "{{reportSource}}",
        "equals": "flex"
      },
      "progress": "Closing Flex report tab…"
    }
  ],
  "retryPolicy": {
    "attempts": 1,
    "delayMs": 1200
  },
  "successMessage": "Capacity report data extracted.",
  "runtimeContract": "stable-host-12",
  "businessLogicOwner": "remote",
  "remoteBehaviorVersion": 9
}
