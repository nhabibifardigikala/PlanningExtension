{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Assign Distribution Centers to a user. Choose the saved access email or enter another email, then enter the desired DC count.",
  "runLabel": "Assign DCs",
  "inputs": [
    {
      "name": "useConfiguredEmail",
      "label": "Use configured email",
      "type": "checkbox",
      "defaultChecked": true,
      "hideFields": [
        "email"
      ],
      "help": "Use the email saved in Settings."
    },
    {
      "name": "email",
      "label": "User email",
      "type": "email",
      "requiredUnless": "useConfiguredEmail",
      "placeholder": "name@digikala.com",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "validationMessage": "Enter a valid email address."
    },
    {
      "name": "dcCount",
      "label": "Number of DCs",
      "type": "number",
      "required": true,
      "min": 1,
      "placeholder": "e.g. 40",
      "pattern": "^\\d+$",
      "validationMessage": "Number of DCs must be a positive whole number."
    }
  ],
  "inputRules": [
    {
      "when": {
        "field": "useConfiguredEmail",
        "equals": true
      },
      "target": "email",
      "source": "credentialUsername"
    }
  ],
  "navigation": {
    "retryCount": 10,
    "retryDelayMs": 400,
    "completeTimeoutMs": 30000
  },
  "successMessage": "DC assignment completed successfully for {{email}}.",
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/dc-user/item/0/?_back=https://lg.digikala.com/dc-user/",
      "progress": "Opening DC User Assignment…",
      "active": true
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "progress": "Checking authentication…"
    },
    {
      "action": "pagedBatchSubmit",
      "count": "{{dcCount}}",
      "itemsPerPage": 20,
      "pagesPerBatch": 15,
      "resetUrl": "https://lg.digikala.com/dc-user/item/0/?_back=https://lg.digikala.com/dc-user/",
      "openerSelector": "a.chooseItemLink[title=\"click to choose\"], a.chooseItemLink",
      "openerTimeoutMs": 20000,
      "afterOpenMs": 1000,
      "selectAllSelector": "#admin-dynamic-clear-all",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "chooseSelector": "button.admin-dynamic-choose[data-action-type=\"choose\"]",
      "frameTimeoutMs": 20000,
      "nextTimeoutMs": 7000,
      "chooseTimeoutMs": 15000,
      "afterSelectMs": 700,
      "afterNextMs": 1400,
      "afterChooseMs": 1000,
      "batchProgress": "Assigning up to 300 DCs — batch {{batch}} of {{batches}}…",
      "skipProgress": "Moving to DC page {{page}}…",
      "pageProgress": "Selecting DC page {{page}} of {{pages}}…",
      "autocomplete": {
        "selector": "input[type=\"text\"].uk-select.es-input[placeholder=\"\"]",
        "value": "{{email}}",
        "attempts": 5,
        "verifyNonEmpty": true,
        "retryDelayMs": 600,
        "error": "Could not set the user email.",
        "options": {
          "typingDelayMs": 110,
          "autocompleteWaitMs": 1800,
          "pressEnter": true,
          "commitWaitMs": 1200,
          "outsideSelector": "button.form-save-button.admin-submit-button",
          "outsideWaitMs": 700,
          "selectorIndex": -1
        }
      },
      "beforeSubmitMs": 700,
      "submit": {
        "selector": "button.form-save-button.admin-submit-button",
        "textContains": "save",
        "error": "Save button was not found.",
        "acceptNavigation": true,
        "navigationGraceMs": 10000,
        "navigationCheckIntervalMs": 250
      },
      "outcomeTimeoutMs": 30000,
      "outcomeIntervalMs": 250,
      "afterSubmitMs": 1500,
      "progress": "Assigning Distribution Centers…",
      "terminalMatchBehavior": "stop",
      "terminalSuccessMessage": "DC assignment completed successfully. User and DC relation already exists.",
      "terminalSuccessTexts": [
        "User and DC relation already exists"
      ]
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 1500
  }
}
