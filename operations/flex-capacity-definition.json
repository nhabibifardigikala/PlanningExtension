{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "requiredHosts": [
    "https://flex.digikala.com/*",
    "https://auth.mydigikala.com/*",
    "https://drop-shipping.digikala.com/*"
  ],
  "description": "Upload a completed capacity template and run the batch operation.",
  "inputs": [
    {
      "name": "templateDownload",
      "label": "Capacity Slot Template",
      "type": "download",
      "buttonLabel": "Download Template",
      "asset": "templates/CapacitySlotTemplate.xlsx",
      "filename": "CapacitySlotTemplate.xlsx",
      "help": "Download and complete the template before running the operation."
    },
    {
      "name": "capacityFile",
      "label": "Upload Excel",
      "type": "file",
      "accept": ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "required": true,
      "help": "Upload the completed Capacity Slot Template."
    }
  ],
  "clientProcessor": {
    "type": "excel-batch-workflow",
    "fileField": "capacityFile",
    "maxRetries": 2,
    "retryDelayMs": 2500,
    "columnMap": {
      "hubNetworkId": "Hub Network ID",
      "hubTimeSlotId": "Hub Time Slot ID",
      "timeSlotName": "Time Slot",
      "dailyCapacity": "Daily Capacity",
      "startDate": "Start date",
      "endDate": "End date",
      "saturday": "Saturday",
      "sunday": "Sunday",
      "monday": "Monday",
      "tuesday": "Tuesday",
      "wednesday": "Wednesday",
      "thursday": "Thursday",
      "friday": "Friday",
      "volumeCapacity": "Volume Capacity",
      "weightCapacity": "Weight Capacity",
      "shippingSize": "Shipping Size",
      "pickupReservable": "Pickup Reservable",
      "deliveryReservable": "Delivery Reservable",
      "activeForDropShipping": "Active For Drop Shipping",
      "dropNetworkId": "Drop Network ID",
      "active": "Active"
    },
    "booleanFields": [
      "saturday",
      "sunday",
      "monday",
      "tuesday",
      "wednesday",
      "thursday",
      "friday",
      "pickupReservable",
      "deliveryReservable",
      "activeForDropShipping"
    ],
    "validation": {
      "required": [
        "dropNetworkId",
        "hubNetworkId",
        "hubTimeSlotId",
        "dailyCapacity",
        "startDate",
        "endDate",
        "volumeCapacity",
        "weightCapacity",
        "shippingSize",
        "activeForDropShipping"
      ],
      "atLeastOne": [
        [
          "saturday",
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday"
        ]
      ],
      "mutuallyExclusive": [
        [
          "pickupReservable",
          "deliveryReservable"
        ]
      ],
      "labels": {
        "hubNetworkId": "Hub Network ID",
        "hubTimeSlotId": "Hub Time Slot ID",
        "dailyCapacity": "Daily Capacity",
        "startDate": "Start date",
        "endDate": "End date",
        "volumeCapacity": "Volume Capacity",
        "weightCapacity": "Weight Capacity",
        "shippingSize": "Shipping Size",
        "activeForDropShipping": "Active For Drop Shipping",
        "dropNetworkId": "Drop Network ID",
        "active": "Active"
      }
    },
    "result": {
      "resultColumn": "Result",
      "successText": "Done",
      "existingText": "Existing capacity slot",
      "downloadButtonLabel": "Download Result",
      "sheetName": "Results",
      "filename": "flex_capacity_result_{{timestamp}}.xlsx",
      "successFill": "C6EFCE",
      "failureFill": "FFC7CE",
      "notProcessedText": "Not processed (cancelled)",
      "confirmationText": "Capacity verified",
      "repeatUntilConfirmation": false,
      "preserveConfirmationMessage": true,
      "failureText": "Manual check required"
    },
    "tabSession": {
      "enabled": true,
      "background": true,
      "reuseForBatch": true,
      "closeOnFinish": true,
      "closeOnCancel": true
    }
  },
  "workflow": [
    {
      "action": "setContext",
      "name": "resultText",
      "value": "Capacity verified (Skipped Active=0)",
      "when": {
        "left": "{{active}}",
        "equals": "0"
      }
    },
    {
      "action": "open",
      "url": "https://flex.digikala.com/hubs/capacity-slots/item/0/?_back=https://flex.digikala.com/hubs/capacity-slots/",
      "progress": "Opening Flex Capacity form…",
      "completeTimeoutMs": 30000,
      "active": false,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 750,
      "progress": "Checking session…",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "navigate",
      "url": "https://flex.digikala.com/hubs/capacity-slots/item/0/?_back=https://flex.digikala.com/hubs/capacity-slots/",
      "completeTimeoutMs": 30000,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "waitFor",
      "selector": "input.uk-select.es-input",
      "timeoutMs": 20000,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input",
      "value": "{{hubNetworkId}}",
      "attempts": 3,
      "options": {
        "focusWaitMs": 700,
        "typingDelayMs": 50,
        "autocompleteWaitMs": 1000,
        "pressEnter": true,
        "commitWaitMs": 1000,
        "outsideWaitMs": 500,
        "selectorIndex": 0
      },
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "wait",
      "ms": 500,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input",
      "value": "{{hubTimeSlotId}}",
      "attempts": 3,
      "options": {
        "focusWaitMs": 700,
        "typingDelayMs": 50,
        "autocompleteWaitMs": 1000,
        "pressEnter": true,
        "commitWaitMs": 1000,
        "outsideWaitMs": 500,
        "selectorIndex": 1
      },
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "wait",
      "ms": 500,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "pressGlobal",
      "key": "Tab",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "wait",
      "ms": 100,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "pressGlobal",
      "key": "Tab",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "wait",
      "ms": 100,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "pressGlobal",
      "key": "Tab",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-from",
      "value": "{{startDate}}",
      "options": {
        "slashFormat": false,
        "waitBeforeOutsideMs": 300,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 200
      },
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "jalaliDate",
      "selector": "#form-field-to",
      "value": "{{endDate}}",
      "options": {
        "slashFormat": false,
        "waitBeforeOutsideMs": 300,
        "pressShift": true,
        "outsideX": 100,
        "outsideY": 100,
        "afterOutsideMs": 200
      },
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"saturday\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{saturday}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"saturday\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{saturday}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"sunday\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{sunday}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"sunday\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{sunday}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"monday\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{monday}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"monday\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{monday}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"tuesday\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{tuesday}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"tuesday\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{tuesday}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"wednesday\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{wednesday}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"wednesday\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{wednesday}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"thursday\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{thursday}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"thursday\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{thursday}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"friday\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{friday}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"friday\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{friday}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "fill",
      "selector": "#form-field-daily_capacity",
      "value": "{{dailyCapacity}}",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "fill",
      "selector": "#form-field-volume_capacity",
      "value": "{{volumeCapacity}}",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "fill",
      "selector": "#form-field-weight_capacity",
      "value": "{{weightCapacity}}",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input",
      "value": "{{shippingSize}}",
      "attempts": 3,
      "options": {
        "focusWaitMs": 700,
        "typingDelayMs": 50,
        "autocompleteWaitMs": 1000,
        "pressEnter": true,
        "commitWaitMs": 1000,
        "outsideWaitMs": 500,
        "selectorIndex": -1
      },
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "wait",
      "ms": 500,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"delivery_reservable\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{deliveryReservable}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"delivery_reservable\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{deliveryReservable}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"pickup_reservable\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{pickupReservable}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"pickup_reservable\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{pickupReservable}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"is_active_for_drop_shipping\"][type=\"checkbox\"]",
      "checked": true,
      "when": {
        "left": "{{active}}|{{activeForDropShipping}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    },
    {
      "action": "setChecked",
      "selector": "input[name=\"is_active_for_drop_shipping\"][type=\"checkbox\"]",
      "checked": false,
      "when": {
        "left": "{{active}}|{{activeForDropShipping}}",
        "operator": "regex",
        "right": "^1\\|false$"
      }
    },
    {
      "action": "wait",
      "ms": 2000,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "click",
      "selector": "button.form-save-button",
      "progress": "Saving capacity slot…",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "wait",
      "ms": 2000,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "setContext",
      "name": "resultText",
      "value": "Save status unclear (no alert found).",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "read",
      "selector": ".uk-alert-success",
      "required": false,
      "storeAs": "successAlert",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "setContext",
      "name": "resultText",
      "value": "Done",
      "when": {
        "left": "{{active}}|{{context.successAlert}}",
        "operator": "regex",
        "right": "^1\\|.+$"
      }
    },
    {
      "action": "read",
      "selector": ".uk-alert-danger",
      "required": false,
      "storeAs": "errorAlert",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "setContext",
      "name": "resultText",
      "value": "{{context.errorAlert}}",
      "when": {
        "left": "{{active}}|{{context.errorAlert}}",
        "operator": "regex",
        "right": "^1\\|.+$"
      }
    },
    {
      "action": "navigate",
      "url": "https://drop-shipping.digikala.com/shipping-network-capacity/",
      "progress": "Verifying created capacity…",
      "completeTimeoutMs": 30000,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 750,
      "progress": "Checking verification session…",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "waitFor",
      "selector": "input[placeholder=\"Shipping Network\"]",
      "timeoutMs": 20000,
      "error": "Shipping Network search field was not found.",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "autocomplete",
      "selector": "input[placeholder=\"Shipping Network\"]",
      "value": "{{dropNetworkId}}",
      "attempts": 3,
      "options": {
        "focusWaitMs": 500,
        "typingDelayMs": 55,
        "autocompleteWaitMs": 1200,
        "pressEnter": true,
        "commitWaitMs": 900,
        "outsideWaitMs": 350,
        "selectorIndex": 0
      },
      "error": "Could not select Drop Network ID {{dropNetworkId}} for verification.",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "wait",
      "ms": 700,
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "click",
      "selector": "button.uk-button.uk-button-primary",
      "textContains": "search",
      "afterMs": 2500,
      "error": "Capacity search button was not found.",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 20000,
      "error": "No capacity rows were returned for Drop Network ID {{dropNetworkId}}.",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "verifyFirstTableRow",
      "storeAs": "capacityVerification",
      "required": false,
      "options": {
        "tableSelector": "table",
        "headerSelector": "thead th",
        "rowSelector": "tbody tr",
        "rowIndex": 0,
        "timeScopeAliases": [
          "Time Scope",
          "Time Slot",
          "time_scope"
        ],
        "dateAliases": [
          "Date"
        ],
        "createdAtAliases": [
          "Created At",
          "created_at"
        ],
        "expectedTimeScope": "{{timeSlotName}}",
        "expectedDate": "{{endDate}}",
        "retryWhenActualDateAtLeastDaysAfterExpected": 7,
        "requireCreatedToday": false
      },
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "setContext",
      "name": "resultText",
      "value": "Manual check required — {{context.capacityVerification.message}}",
      "when": {
        "left": "{{active}}",
        "equals": "1"
      }
    },
    {
      "action": "setContext",
      "name": "resultText",
      "value": "Capacity verified",
      "when": {
        "left": "{{active}}|{{context.capacityVerification.ok}}",
        "operator": "regex",
        "right": "^1\\|true$"
      }
    }
  ],
  "successMessage": "{{context.resultText}}",
  "retryPolicy": {
    "attempts": 1,
    "delayMs": 500
  },
  "navigation": {
    "retryCount": 8,
    "retryDelayMs": 350,
    "completeTimeoutMs": 30000
  },
  "uiMode": "form",
  "runLabel": "Run",
  "runtimeContract": "stable-host-12",
  "businessLogicOwner": "remote"
}
