{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Extract all Shipping Network Time Distance pages into the Agents dataset. Publishing is owned by Stable Jobs and only occurs after successful full extraction.",
  "navigation": {
    "retryCount": 5,
    "retryDelayMs": 750,
    "completeTimeoutMs": 60000
  },
  "successMessage": "Shipping Network TD: {{rowCount}} rows extracted successfully.",
  "workflow": [
    {
      "action": "open",
      "url": "https://drop-shipping.digikala.com/shipping-network/time-distance-config/?id=&shipping_network_id=0&time_scope_id=0&active=&per_page=1000&crud_tab_id=&page=1",
      "active": false,
      "progress": "Opening Time Distance page 1 (1000 rows per page)…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 15000,
      "progress": "Checking Drop Shipping login…"
    },
    {
      "action": "navigate",
      "url": "https://drop-shipping.digikala.com/shipping-network/time-distance-config/?id=&shipping_network_id=0&time_scope_id=0&active=&per_page=1000&crud_tab_id=&page=1",
      "active": false,
      "completeTimeoutMs": 60000,
      "progress": "Opening Time Distance page 1 with no status filters…"
    },
    {
      "action": "waitFor",
      "selector": "table",
      "timeoutMs": 25000,
      "intervalMs": 300,
      "error": "Time Distance table was not found."
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 25000,
      "intervalMs": 300,
      "error": "Time Distance table contains no rows. Nothing will be published."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[rel='next'],a[aria-label='Next page'],a[title*='Next'],.uk-pagination-next a",
      "timeoutMs": 60000,
      "stableMs": 2200,
      "pollMs": 500,
      "afterPageMs": 650,
      "expectedRowsPerPage": 0,
      "allowLastPagePartial": true,
      "maxPages": 1000,
      "strictPagination": true,
      "strictStability": true,
      "strictPageSequence": true,
      "pageParam": "page",
      "requiredQueryParams": {
        "per_page": "1000"
      },
      "dedupe": false,
      "ignoreLastActionColumn": true,
      "parser": {
        "tableSelector": "table",
        "headerSelector": "thead th",
        "rowSelector": "tbody tr",
        "svgBoolean": true,
        "appendAttributes": [
          {
            "header": "__details_url",
            "selector": "a[href]",
            "attribute": "href",
            "textIncludes": "details",
            "attributeIncludes": "/shipping-network/"
          }
        ]
      },
      "pageProgress": "Extracting Shipping Network TD page {{page}}…",
      "progress": "Extracting all Shipping Network TD pages…",
      "error": "Time Distance page had no data. Nothing was replaced."
    },
    {
      "action": "enrichTableFromLookupAndDetails",
      "lookupInput": "shippingNetworkLookup",
      "sourceNameAliases": [
        "shipping network",
        "shipping network name",
        "network",
        "network name",
        "نام نتورک",
        "نام شبکه"
      ],
      "lookupNameAliases": [
        "shipping network",
        "shipping network name",
        "network",
        "network name",
        "name",
        "title",
        "نام نتورک",
        "نام شبکه"
      ],
      "lookupIdAliases": [
        "shipping network id",
        "shipping_network_id",
        "network id",
        "network_id",
        "id",
        "شناسه نتورک",
        "شناسه شبکه"
      ],
      "detailsUrlHeader": "__details_url",
      "outputHeader": "shipping_network_id",
      "inputSelector": "input.uk-select.es-input[disabled]",
      "valuePattern": "\\[\\s*([0-9۰-۹٠-٩]+)\\s*\\]",
      "concurrency": 4,
      "required": true,
      "detailsCompleteTimeoutMs": 60000,
      "detailsPathIncludes": "/shipping-network/",
      "detailsTimeoutMs": 25000,
      "detailsPollMs": 300,
      "resultMessage": "Network IDs resolved: {{fromLookup}} from Shipping Network, {{fromDetails}} from Details."
    },
    {
      "action": "closeTab",
      "progress": "Closing Time Distance tab…"
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 2000
  },
  "runtimeContract": "stable-host-13.0.21",
  "businessLogicOwner": "remote",
  "output": {
    "type": "sheet"
  },
  "closeTabOnError": true
}
