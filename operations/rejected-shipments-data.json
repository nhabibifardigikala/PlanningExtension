{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Credential-safe Rejected Shipments extraction matching the supplied v4.9 control-center workflow.",
  "runLabel": "Sync Now",
  "navigation": {
    "retryCount": 5,
    "retryDelayMs": 500,
    "completeTimeoutMs": 45000
  },
  "successMessage": "Rejected Shipments extraction completed.",
  "workflow": [
    {
      "action": "open",
      "url": "https://drop-shipping.digikala.com/shipment/?id=&reference_id=&status=rejected&user_id=0&origin_user_address_id=0&destination_user_address_id=0&origin_shipping_point_address_id=0&destination_shipping_point_address_id=0&ready_date=&from_promise_date=&to_promise_date=&crud_tab_id=&order=1&order_by=id&order_type=DESC",
      "active": false,
      "progress": "Opening rejected shipments…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 7000,
      "progress": "Checking Drop Shipping authentication…"
    },
    {
      "action": "navigate",
      "url": "https://drop-shipping.digikala.com/shipment/?id=&reference_id=&status=rejected&user_id=0&origin_user_address_id=0&destination_user_address_id=0&origin_shipping_point_address_id=0&destination_shipping_point_address_id=0&ready_date=&from_promise_date=&to_promise_date=&crud_tab_id=&order=1&order_by=id&order_type=DESC",
      "progress": "Loading rejected shipments…",
      "completeTimeoutMs": 45000
    },
    {
      "action": "waitFor",
      "selector": "table",
      "timeoutMs": 30000,
      "intervalMs": 300,
      "progress": "Waiting for shipment table…",
      "error": "Rejected Shipments table did not become ready."
    },
    {
      "action": "setTabZoom",
      "zoom": 0.5,
      "progress": "Preparing shipment table…"
    },
    {
      "action": "configureColumns",
      "columns": {
        "id": true,
        "reference_id": true,
        "user_id": true,
        "ready_date": true,
        "status": true,
        "created_at": true,
        "service_level": true,
        "shipping_size_id": true,
        "destination_address": true,
        "destination_shipping_point": true,
        "parcel_ids": true,
        "promise_date": true
      },
      "options": {
        "exact": true,
        "buttonText": "Columns",
        "buttonSelector": "button",
        "menuSelector": "ul#adminColumns,[uk-dropdown],.uk-dropdown,[role=\"menu\"],.dropdown-menu,.popover",
        "checkboxSelector": "input[type=\"checkbox\"]",
        "aliases": {
          "id": [
            "id"
          ],
          "reference_id": [
            "reference id",
            "reference_id"
          ],
          "user_id": [
            "user id",
            "user_id"
          ],
          "ready_date": [
            "ready date",
            "ready_date"
          ],
          "status": [
            "status"
          ],
          "created_at": [
            "created at",
            "created_at"
          ],
          "service_level": [
            "service level",
            "service_level"
          ],
          "shipping_size_id": [
            "shipping size id",
            "shipping_size_id"
          ],
          "destination_address": [
            "destination address",
            "destination_address"
          ],
          "destination_shipping_point": [
            "destination shipping point",
            "destination_shipping_point"
          ],
          "parcel_ids": [
            "parcel ids",
            "parcel_ids"
          ],
          "promise_date": [
            "promise date",
            "promise_date"
          ]
        },
        "menuTimeoutMs": 12000,
        "afterEachMs": 180,
        "maxChanges": 80
      },
      "storeAs": "columnSelection",
      "stepAttempts": 4,
      "stepRetryDelayMs": 1000,
      "progress": "Selecting exactly the 12 required shipment columns…",
      "retryProgress": "Retrying exact column configuration ({{attempt}}/{{attempts}})…",
      "error": "The exact Rejected Shipments column set could not be configured."
    },
    {
      "action": "clickOutside",
      "center": true,
      "progress": "Applying shipment columns…"
    },
    {
      "action": "wait",
      "ms": 1000,
      "progress": "Waiting for column changes…"
    },
    {
      "action": "navigate",
      "url": "https://drop-shipping.digikala.com/shipment/?id=&reference_id=&status=rejected&user_id=0&origin_user_address_id=0&destination_user_address_id=0&origin_shipping_point_address_id=0&destination_shipping_point_address_id=0&ready_date=&from_promise_date=&to_promise_date=&crud_tab_id=&order=1&order_by=id&order_type=DESC&per_page=1000",
      "completeTimeoutMs": 45000,
      "progress": "Setting rows per page to 1000…"
    },
    {
      "action": "waitFor",
      "selector": "select[name=\"per_page\"], table tbody tr",
      "timeoutMs": 30000,
      "intervalMs": 300,
      "progress": "Waiting for 1000-row shipment page…"
    },
    {
      "action": "read",
      "selector": "select[name=\"per_page\"]",
      "storeAs": "perPage",
      "required": true,
      "error": "Rows-per-page selector was not found."
    },
    {
      "action": "assert",
      "condition": {
        "left": "{{perPage}}",
        "equals": "1000"
      },
      "error": "Rows per page did not become 1000."
    },
    {
      "action": "validateTableColumns",
      "required": [
        "id",
        "reference_id",
        "user_id",
        "ready_date",
        "status",
        "created_at",
        "service_level",
        "shipping_size_id",
        "destination_address",
        "destination_shipping_point",
        "parcel_ids",
        "promise_date"
      ],
      "options": {
        "tableSelector": "table",
        "headerSelector": "thead th",
        "aliases": {
          "id": [
            "id"
          ],
          "reference_id": [
            "reference id",
            "reference_id"
          ],
          "user_id": [
            "user id",
            "user_id"
          ],
          "ready_date": [
            "ready date",
            "ready_date"
          ],
          "status": [
            "status"
          ],
          "created_at": [
            "created at",
            "created_at"
          ],
          "service_level": [
            "service level",
            "service_level"
          ],
          "shipping_size_id": [
            "shipping size id",
            "shipping_size_id"
          ],
          "destination_address": [
            "destination address",
            "destination_address"
          ],
          "destination_shipping_point": [
            "destination shipping point",
            "destination_shipping_point"
          ],
          "parcel_ids": [
            "parcel ids",
            "parcel_ids"
          ],
          "promise_date": [
            "promise date",
            "promise_date"
          ]
        }
      },
      "stepAttempts": 4,
      "stepRetryDelayMs": 900,
      "progress": "Verifying rendered shipment columns…",
      "error": "The rendered shipment table does not contain the exact required columns."
    },
    {
      "action": "extractPaginatedTable",
      "maxPages": 100,
      "timeoutMs": 30000,
      "stableMs": 1200,
      "pollMs": 300,
      "expectedRowsPerPage": 1000,
      "allowLastPagePartial": true,
      "afterPageMs": 700,
      "dedupe": true,
      "ignoreLastActionColumn": true,
      "stopWhen": {
        "column": "id",
        "aliases": [
          "id"
        ],
        "operator": "lte",
        "numeric": true,
        "value": "{{previousMaxId}}",
        "includeMatching": false,
        "firstPageOnlyWhenZero": true,
        "required": true
      },
      "parser": {
        "tableSelector": "table",
        "headerSelector": "thead th",
        "rowSelector": "tbody tr",
        "svgBoolean": false
      },
      "stepAttempts": 4,
      "stepRetryDelayMs": 1200,
      "progress": "Extracting rejected shipments…",
      "pageProgress": "Extracting rejected shipment page {{page}}…",
      "retryProgress": "Repairing extraction and retrying ({{attempt}}/{{attempts}})…",
      "error": "Rejected shipment rows could not be extracted.",
      "nextSelector": "a[rel=\"next\"], a[aria-label=\"Next page\"], a[title*=\"Next\"], .uk-pagination-next a"
    },
    {
      "action": "setTabZoom",
      "zoom": 1,
      "when": {
        "left": "{{keepScrapeTabOpen}}",
        "equals": "true"
      },
      "progress": "Restoring shipment tab zoom…"
    },
    {
      "action": "closeTab",
      "when": {
        "left": "{{keepScrapeTabOpen}}",
        "equals": "false"
      },
      "progress": "Closing extraction tab…"
    }
  ],
  "subOperations": [
    {
      "id": "open-reference",
      "title": "Open shipment",
      "requiresCredentials": true,
      "workflow": [
        {
          "action": "open",
          "url": "https://drop-shipping.digikala.com/shipment/",
          "active": true,
          "progress": "Opening shipment search…"
        },
        {
          "action": "ensureLogin",
          "detectTimeoutMs": 7000,
          "progress": "Checking authentication…"
        },
        {
          "action": "waitFor",
          "selector": "input[name=\"reference_id\"]",
          "timeoutMs": 30000,
          "progress": "Waiting for Reference ID search…"
        },
        {
          "action": "fill",
          "selector": "input[name=\"reference_id\"]",
          "value": "{{referenceId}}",
          "progress": "Setting Reference ID…"
        },
        {
          "action": "submitNearestForm",
          "selector": "input[name=\"reference_id\"]",
          "waitForNavigation": true,
          "completeTimeoutMs": 30000,
          "progress": "Searching shipment…"
        }
      ],
      "successMessage": "Shipment opened."
    }
  ],
  "runtimeContract": "stable-host-12",
  "businessLogicOwner": "remote"
}
