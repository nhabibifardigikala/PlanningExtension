{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Credential-safe scheduled/manual extraction for the standalone Rejected Shipments dashboard.",
  "runLabel": "Sync Now",
  "navigation": {
    "retryCount": 5,
    "retryDelayMs": 500,
    "completeTimeoutMs": 45000
  },
  "successMessage": "Rejected Shipments extraction completed.",
  "workflow": [
    {
      "action": "open",
      "url": "https://drop-shipping.digikala.com/shipment/?status=rejected&order=1&order_by=id&order_type=DESC&per_page=1000",
      "active": false,
      "progress": "Opening rejected shipments…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 7000,
      "progress": "Checking Drop Shipping authentication…"
    },
    {
      "action": "navigate",
      "url": "https://drop-shipping.digikala.com/shipment/?status=rejected&order=1&order_by=id&order_type=DESC&per_page=1000",
      "progress": "Loading rejected shipments with 1000 rows…",
      "completeTimeoutMs": 45000
    },
    {
      "action": "waitFor",
      "selector": "table, button",
      "timeoutMs": 30000,
      "intervalMs": 300,
      "progress": "Waiting for Shipments…",
      "error": "Rejected Shipments page did not become ready."
    },
    {
      "action": "setPageZoom",
      "zoom": 0.5,
      "progress": "Preparing shipment table…"
    },
    {
      "action": "configureColumns",
      "columns": {
        "id": true,
        "reference_id": true,
        "user_id": true,
        "ready_date": true,
        "status": true,
        "created_at": true,
        "service_level": true,
        "shipping_size_id": true,
        "destination_address": true,
        "destination_shipping_point": true,
        "parcel_ids": true,
        "promise_date": true
      },
      "options": {
        "buttonText": "Columns",
        "buttonSelector": "button",
        "checkboxSelector": "ul#adminColumns input[type=\"checkbox\"], [uk-dropdown] input[type=\"checkbox\"], .uk-dropdown input[type=\"checkbox\"]",
        "menuTimeoutMs": 12000,
        "afterEachMs": 220,
        "maxChanges": 60
      },
      "stepAttempts": 3,
      "stepRetryDelayMs": 1000,
      "progress": "Selecting required shipment columns…",
      "error": "Required Rejected Shipments columns could not be selected."
    },
    {
      "action": "clickOutside",
      "x": 18,
      "y": 18,
      "progress": "Applying selected columns…"
    },
    {
      "action": "wait",
      "ms": 1600,
      "progress": "Waiting for the shipment table to reload…"
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 30000,
      "intervalMs": 400,
      "progress": "Waiting for rejected shipment rows…",
      "error": "No rejected shipment rows were found."
    },
    {
      "action": "extractPaginatedTable",
      "maxPages": 1,
      "timeoutMs": 30000,
      "stableMs": 1200,
      "pollMs": 300,
      "dedupe": false,
      "ignoreLastActionColumn": false,
      "parser": {
        "tableSelector": "table",
        "headerSelector": "thead th",
        "rowSelector": "tbody tr",
        "svgBoolean": false
      },
      "progress": "Extracting latest rejected shipments…",
      "error": "Rejected shipment rows could not be extracted."
    },
    {
      "action": "closeTab",
      "progress": "Closing extraction tab…"
    }
  ],
  "subOperations": [
    {
      "id": "open-reference",
      "title": "Open shipment",
      "requiresCredentials": true,
      "workflow": [
        {
          "action": "open",
          "url": "https://drop-shipping.digikala.com/shipment/",
          "active": true,
          "progress": "Opening shipment search…"
        },
        {
          "action": "ensureLogin",
          "detectTimeoutMs": 7000,
          "progress": "Checking authentication…"
        },
        {
          "action": "waitFor",
          "selector": "input[name=\"reference_id\"]",
          "timeoutMs": 30000,
          "progress": "Waiting for Reference ID search…"
        },
        {
          "action": "fill",
          "selector": "input[name=\"reference_id\"]",
          "value": "{{referenceId}}",
          "progress": "Setting Reference ID…"
        },
        {
          "action": "submitNearestForm",
          "selector": "input[name=\"reference_id\"]",
          "waitForNavigation": true,
          "completeTimeoutMs": 30000,
          "progress": "Searching shipment…"
        }
      ],
      "successMessage": "Shipment opened."
    }
  ],
  "runtimeContract": "stable-host-12",
  "businessLogicOwner": "remote"
}
