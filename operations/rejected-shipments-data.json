{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Rejected Shipments incremental synchronizer. Reads the current max value of the exact Google Sheet id column, applies the rejected filter, verifies all 12 required source columns, sets 1000 rows per page, and extracts only IDs newer than the Sheet watermark.",
  "runLabel": "Sync Now",
  "navigation": {
    "retryCount": 5,
    "retryDelayMs": 500,
    "completeTimeoutMs": 45000
  },
  "successMessage": "Rejected Shipments extraction completed.",
