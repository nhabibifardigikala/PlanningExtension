  "subOperations": [
    {
      "id": "open-reference",
      "title": "Open shipment",
      "requiresCredentials": true,
      "workflow": [
        {
          "action": "open",
          "url": "https://drop-shipping.digikala.com/shipment/",
          "active": true,
          "progress": "Opening shipment search…"
        },
        {
          "action": "ensureLogin",
          "detectTimeoutMs": 7000,
          "progress": "Checking authentication…"
        },
        {
          "action": "waitFor",
          "selector": "input[name=\"reference_id\"]",
          "timeoutMs": 30000,
          "progress": "Waiting for Reference ID search…"
        },
        {
          "action": "fill",
          "selector": "input[name=\"reference_id\"]",
          "value": "{{referenceId}}",
          "progress": "Setting Reference ID…"
        },
        {
          "action": "submitNearestForm",
          "selector": "input[name=\"reference_id\"]",
          "waitForNavigation": true,
          "completeTimeoutMs": 30000,
          "progress": "Searching shipment…"
        }
      ],
      "successMessage": "Shipment opened."
    },
    {
      "id": "resolve-destination",
      "title": "Resolve Destination coverage polygon",
      "requiresCredentials": true,
      "workflow": [
        {
          "action": "open",
          "url": "https://drop-shipping.digikala.com/shipment/",
          "active": false,
          "progress": "Opening shipment {{shipmentId}}…",
          "when": {
            "left": "{{shipmentId}}",
            "operator": "gt",
            "right": 0
          }
        },
        {
          "action": "ensureLogin",
          "detectTimeoutMs": 7000,
          "progress": "Checking Drop Shipping authentication…",
          "when": {
            "left": "{{shipmentId}}",
            "operator": "gt",
            "right": 0
          }
        },
        {
          "action": "waitFor",
          "selector": "input[name=\"id\"]",
          "timeoutMs": 30000,
          "intervalMs": 300,
          "progress": "Waiting for shipment ID search…",
          "when": {
            "left": "{{shipmentId}}",
            "operator": "gt",
            "right": 0
          }
        },
        {
          "action": "fill",
          "selector": "input[name=\"id\"]",
          "value": "{{shipmentId}}",
          "progress": "Setting shipment ID {{shipmentId}}…",
          "when": {
            "left": "{{shipmentId}}",
            "operator": "gt",
            "right": 0
          }
        },
        {
          "action": "submitNearestForm",
          "selector": "input[name=\"id\"]",
          "waitForNavigation": true,
          "completeTimeoutMs": 30000,
          "progress": "Submitting shipment ID search…",
          "error": "Shipment ID search form could not be submitted.",
          "when": {
            "left": "{{shipmentId}}",
            "operator": "gt",
            "right": 0
          }
        },
        {
          "action": "wait",
          "ms": 1000,
          "progress": "Waiting for shipment search results…",
          "when": {
            "left": "{{shipmentId}}",
            "operator": "gt",
            "right": 0
          }
        },
        {
          "action": "read",
          "selector": "a[title=\"Routes\"][href*=\"/shipments-routes/\"], a[href*=\"/shipments-routes/\"][href*=\"shipment_id=\"]",
          "attribute": "href",
          "required": false,
          "storeAs": "routesHref",
          "progress": "Checking Routes result…",
          "when": {
            "left": "{{shipmentId}}",
            "operator": "gt",
            "right": 0
          }
        },
        {
          "action": "click",
          "selector": "a[title=\"Routes\"][href*=\"/shipments-routes/\"], a[href*=\"/shipments-routes/\"][href*=\"shipment_id=\"]",
          "afterMs": 1200,
          "progress": "Opening Routes…",
          "when": {
            "left": "{{routesHref}}",
            "operator": "truthy",
            "right": ""
          }
        },
        {
          "action": "wait",
          "ms": 800,
          "progress": "Waiting for Routes page…",
          "when": {
            "left": "{{routesHref}}",
            "operator": "truthy",
            "right": ""
          }
        },
        {
          "action": "read",
          "selector": "a[title=\"Steps\"][href*=\"/route-steps/\"], a[href*=\"/route-steps/\"][href*=\"shipment_route_id=\"]",
          "attribute": "href",
          "required": false,
          "storeAs": "stepsHref",
          "progress": "Checking Steps result…",
          "when": {
            "left": "{{routesHref}}",
            "operator": "truthy",
            "right": ""
          }
        },
        {
          "action": "click",
          "selector": "a[title=\"Steps\"][href*=\"/route-steps/\"], a[href*=\"/route-steps/\"][href*=\"shipment_route_id=\"]",
          "afterMs": 1200,
          "progress": "Opening Steps…",
          "when": {
            "left": "{{stepsHref}}",
            "operator": "truthy",
            "right": ""
          }
        },
        {
          "action": "wait",
          "ms": 800,
          "progress": "Waiting for Route Steps table…",
          "when": {
            "left": "{{stepsHref}}",
            "operator": "truthy",
            "right": ""
          }
        },
        {
          "action": "read",
          "selector": "table tbody tr a[href*=\"shipping-network-capacity\"], table tbody tr a[href*=\"shipping_network_capacity\"], table tbody tr a[href*=\"shipping-network-capacities\"], table tbody tr a[href*=\"shipping_network_capacities\"], table tbody tr a[href*=\"shipping-network-capacity-id\"], table tbody tr a[href*=\"shipping_network_capacity_id\"], table tbody tr a[href*=\"shipping_network_capacity_id=\"], table tbody tr td[data-code=\"shipping_network_capacity_id\"] a, table tbody tr td[data-field=\"shipping_network_capacity_id\"] a",
          "attribute": "href",
          "required": false,
          "storeAs": "capacityHref",
          "progress": "Checking shipping network capacity id…",
          "when": {
            "left": "{{stepsHref}}",
            "operator": "truthy",
            "right": ""
          }
        },
        {
          "action": "click",
          "selector": "table tbody tr a[href*=\"shipping-network-capacity\"], table tbody tr a[href*=\"shipping_network_capacity\"], table tbody tr a[href*=\"shipping-network-capacities\"], table tbody tr a[href*=\"shipping_network_capacities\"], table tbody tr a[href*=\"shipping-network-capacity-id\"], table tbody tr a[href*=\"shipping_network_capacity_id\"], table tbody tr a[href*=\"shipping_network_capacity_id=\"], table tbody tr td[data-code=\"shipping_network_capacity_id\"] a, table tbody tr td[data-field=\"shipping_network_capacity_id\"] a",
          "afterMs": 1200,
          "progress": "Opening shipping network capacity id…",
          "when": {
            "left": "{{capacityHref}}",
            "operator": "truthy",
            "right": ""
          }
        },
        {
