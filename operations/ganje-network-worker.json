    {
      "id": "create-network",
      "title": "Create GANJE network",
      "requiresCredentials": true,
      "requiredHosts": [
        "https://drop-shipping.digikala.com/*",
        "https://auth.mydigikala.com/*"
      ],
      "successMessage": "NETWORK_CREATED",
      "workflow": [
        {
          "action": "open",
          "url": "https://drop-shipping.digikala.com/batch-configs",
          "active": false,
          "progress": "Opening Batch Config…"
        },
        {
          "action": "ensureLogin",
          "detectTimeoutMs": 5000
        },
        {
          "action": "waitFor",
          "selector": "input.uk-select.es-input",
          "timeoutMs": 20000,
          "error": "Batch Config inputs were not found."
        },
        {
          "action": "autocomplete",
          "selector": "input.uk-select.es-input",
          "selectorIndex": 0,
          "value": "{{parentCode}}",
          "attempts": 3,
          "verifyNonEmpty": true,
          "options": {
            "selectorIndex": 0,
            "focusWaitMs": 400,
            "typingDelayMs": 55,
            "autocompleteWaitMs": 1400,
            "pressEnter": true,
            "commitWaitMs": 1000,
            "outsideWaitMs": 350
          },
          "error": "Origin Shipping Point could not be selected by parent code."
        },
        {
          "action": "autocomplete",
          "selector": "input.uk-select.es-input",
          "selectorIndex": 1,
          "value": "{{centerName}}",
          "attempts": 4,
          "verifyNonEmpty": true,
          "options": {
            "selectorIndex": 1,
            "focusWaitMs": 400,
            "typingDelayMs": 55,
            "autocompleteWaitMs": 1600,
            "pressEnter": true,
            "commitWaitMs": 1100,
            "outsideWaitMs": 400
          },
          "error": "Destination Shipping Point could not be selected."
        },
        {
          "action": "jalaliDate",
          "selector": "#form-field-from_date,input[data-name='from_date'],input[name='from_date']",
          "value": "{{startDate}}",
          "options": {
            "slashFormat": true,
            "waitBeforeOutsideMs": 500,
            "pressShift": true,
            "outsideX": 100,
            "outsideY": 100,
            "afterOutsideMs": 300
          },
          "error": "From Date could not be entered."
        },
        {
          "action": "jalaliDate",
          "selector": "#form-field-to_date,input[data-name='to_date'],input[name='to_date']",
          "value": "{{endDate}}",
          "options": {
            "slashFormat": true,
            "waitBeforeOutsideMs": 500,
            "pressShift": true,
            "outsideX": 100,
            "outsideY": 100,
            "afterOutsideMs": 300
          },
          "error": "To Date could not be entered."
        },
        {
          "action": "wait",
          "ms": 1200
        },
        {
          "action": "click",
          "selector": "button,a,input[type='button'],input[type='submit']",
          "textContains": "ADD BATCH CONFIG",
          "afterMs": 2200,
          "error": "ADD BATCH CONFIG was not found or could not be clicked."
        }
      ]
    },
    {
      "id": "deactivate-network",
      "title": "deactivate-network",
      "requiresCredentials": true,
      "successMessage": "NETWORK_TOGGLED",
      "workflow": [
        {
          "action": "open",
          "url": "https://drop-shipping.digikala.com/shipping-network/item/{{networkId}}/",
          "active": false,
          "progress": "Opening Shipping Network {{networkId}}…"
        },
        {
          "action": "ensureLogin",
          "detectTimeoutMs": 5000
        },
        {
          "action": "waitFor",
          "selector": "input[name='active'][type='checkbox'],#form-field-active[type='checkbox'],input[type='checkbox']",
          "timeoutMs": 20000,
          "error": "Active checkbox was not found."
        },
        {
          "action": "setChecked",
          "selector": "input[name='active'][type='checkbox'],#form-field-active[type='checkbox'],input[type='checkbox']",
          "checked": false,
          "progress": "Updating Active status…"
        },
        {
          "action": "click",
          "selector": "button.form-save-button,button.admin-submit-button,button[type='submit'],input[type='submit']",
          "textContains": "SAVE",
          "afterMs": 1800,
          "error": "SAVE button was not found."
        }
      ]
    },
    {
      "id": "activate-network",
