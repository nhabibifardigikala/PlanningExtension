{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "requiredHosts": [
    "https://drop-shipping.digikala.com/*",
    "https://flex.digikala.com/*",
    "https://auth.mydigikala.com/*"
  ],
  "description": "Internal worker for GANJE Network Management.",
  "workflow": [],
  "successMessage": "GANJE worker ready.",
  "output": {
    "type": "internal"
  },
  "subOperations": [
    {
      "id": "search-active",
      "title": "search-active",
      "requiresCredentials": true,
      "requiredHosts": [
        "https://drop-shipping.digikala.com/*",
        "https://auth.mydigikala.com/*"
      ],
      "successMessage": "NETWORK_SEARCH_DONE",
      "workflow": [
        {
          "action": "open",
          "url": "https://drop-shipping.digikala.com/shipping-network/?order=1&order_by=created_at&order_type=ASC",
          "active": false,
          "progress": "Opening Shipping Network…"
        },
        {
          "action": "ensureLogin",
          "detectTimeoutMs": 5000,
          "progress": "Checking authentication…"
        },
        {
          "action": "waitFor",
          "selector": "input[placeholder*='To Shipping Point' i],input[aria-label*='To Shipping Point' i]",
          "timeoutMs": 20000,
          "error": "To Shipping Point filter was not found."
        },
        {
          "action": "autocomplete",
          "selector": "input[placeholder*='To Shipping Point' i],input[aria-label*='To Shipping Point' i]",
          "value": "{{centerName}}",
          "attempts": 3,
          "verifyNonEmpty": true,
          "options": {
            "focusWaitMs": 400,
            "typingDelayMs": 55,
            "autocompleteWaitMs": 1200,
            "pressEnter": true,
            "commitWaitMs": 900,
            "outsideWaitMs": 350,
            "exactMatch": true,
            "matchTransforms": [
              "normalizeUnicode",
              {
                "type": "regexReplace",
                "pattern": "^\\s*\\[[^\\]]+\\]\\s*[-–—:]?\\s*",
                "replacement": ""
              },
              "collapseWhitespace",
              "trim",
              "caseFold"
            ]
          },
          "error": "Exact To Shipping Point could not be selected."
        },
        {
          "action": "autocomplete",
          "when": {
            "left": "{{parentName}}",
            "operator": "truthy"
          },
          "selector": "input[placeholder*='From Shipping Point' i],input[aria-label*='From Shipping Point' i]",
          "value": "{{parentName}}",
          "attempts": 3,
          "verifyNonEmpty": true,
          "options": {
            "focusWaitMs": 400,
            "typingDelayMs": 55,
            "autocompleteWaitMs": 1200,
            "pressEnter": true,
            "commitWaitMs": 900,
            "outsideWaitMs": 350,
            "exactMatch": true,
            "matchTransforms": [
              "normalizeUnicode",
              {
                "type": "regexReplace",
                "pattern": "^\\s*\\[[^\\]]+\\]\\s*[-–—:]?\\s*",
                "replacement": ""
              },
              "collapseWhitespace",
              "trim",
              "caseFold"
            ]
          },
          "error": "Exact From Shipping Point could not be selected."
        },
        {
          "action": "submitNearestForm",
          "selector": "input[placeholder*='To Shipping Point' i],input[aria-label*='To Shipping Point' i]",
          "waitForNavigation": true,
          "completeTimeoutMs": 30000,
          "options": {
            "submitMode": "native-form",
            "hiddenFields": {
              "order": "1",
              "order_by": "created_at",
              "order_type": "ASC",
              "per_page": "1000",
              "active": "1"
            }
          },
          "progress": "Applying exact Shipping Network filters…"
        },
        {
          "action": "waitFor",
          "selector": "table",
          "timeoutMs": 20000,
          "error": "Shipping Network result table did not load."
        },
        {
          "action": "extractPaginatedTable",
          "maxPages": 20,
          "timeoutMs": 6000,
          "stableMs": 700,
          "pollMs": 250,
          "afterPageMs": 500,
          "dedupe": true,
          "ignoreLastActionColumn": true,
          "parser": {
            "tableSelector": "table",
            "headerSelector": "thead th",
            "rowSelector": "tbody tr",
            "svgBoolean": false
          },
          "nextSelector": "a[rel='next'],a[aria-label='Next page'],a[title*='Next'],.uk-pagination-next a",
          "progress": "Reading matching Shipping Networks…"
        }
      ]
    },
