      "requiresCredentials": true,
      "successMessage": "TIME_DISTANCE_DEACTIVATED",
      "workflow": [
        {
          "action": "open",
          "url": "https://drop-shipping.digikala.com/shipping-network/time-distance-config/item/{{timeDistanceId}}/",
          "active": false,
          "progress": "Opening Time Distance {{timeDistanceId}}…"
        },
        {
          "action": "ensureLogin",
