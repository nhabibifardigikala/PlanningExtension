{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Extract all active DC Time Scope rows from LG using 1000 rows per page.",
  "navigation": {
    "retryCount": 5,
    "retryDelayMs": 750,
    "completeTimeoutMs": 60000
  },
  "successMessage": "DC Time Scope source: {{rowCount}} rows extracted successfully.",
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/dc-time-scope/?time_scope_id=0&nature_group=&active=true&per_page=1000&crud_tab_id=&page=1",
      "active": false,
      "progress": "Opening DC Time Scope page 1…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 15000,
      "progress": "Checking LG login…"
    },
    {
      "action": "navigate",
      "url": "https://lg.digikala.com/dc-time-scope/?time_scope_id=0&nature_group=&active=true&per_page=1000&crud_tab_id=&page=1",
      "active": false,
      "completeTimeoutMs": 60000,
      "progress": "Loading active DC Time Scope rows…"
    },
    {
      "action": "waitFor",
      "selector": "table",
      "timeoutMs": 25000,
      "intervalMs": 300,
      "error": "DC Time Scope table was not found."
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 25000,
      "intervalMs": 300,
      "error": "DC Time Scope table contains no rows."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 90000,
      "expectedRowsPerPage": 1000,
      "allowLastPagePartial": true,
      "pollMs": 2000,
      "afterPageMs": 900,
      "dedupe": false,
      "maxPages": 1000,
      "ignoreLastActionColumn": true,
      "parser": {
        "tableSelector": "table",
        "svgBoolean": true
      },
      "pageProgress": "Extracting DC Time Scope page {{page}}…",
      "progress": "Extracting all DC Time Scope pages…",
      "error": "No DC Time Scope rows were found."
    },
    {
      "action": "closeTab",
      "progress": "Closing DC Time Scope tab…"
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 1800
  },
  "runtimeContract": "stable-host-13.0.24",
  "businessLogicOwner": "remote",
  "output": {
    "type": "internal"
  },
  "closeTabOnError": true
}
