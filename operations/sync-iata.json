{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "uiMode": "form",
  "runLabel": "Start IATA Sync",
  "description": "Select which Drop Shipping datasets to synchronize, optionally exclude record IDs, then compare their code values with Distribution Center IATA and correct mismatches.",
  "inputs": [
    {
      "name": "syncTargets",
      "label": "Sync targets",
      "type": "checkbox-group",
      "required": true,
      "default": [
        "shipping-points",
        "shipping-polygons"
      ],
      "options": [
        {
          "value": "shipping-points",
          "label": "Sync shipping points"
        },
        {
          "value": "shipping-polygons",
          "label": "Sync Polygons"
        }
      ],
      "help": "Select one or both datasets to check and correct."
    },
    {
      "name": "pointExceptions",
      "label": "Shipping Point exception IDs",
      "type": "text",
      "placeholder": "e.g. 10, 25, 44",
      "help": "Comma-separated IDs. These Shipping Points will not be checked or modified."
    },
    {
      "name": "polygonExceptions",
      "label": "Shipping Polygon exception IDs",
      "type": "text",
      "placeholder": "e.g. 101, 205, 390",
      "help": "Comma-separated IDs. These Shipping Polygons will not be checked or modified."
    }
  ],
  "navigation": {
    "retryCount": 10,
    "retryDelayMs": 450,
    "completeTimeoutMs": 40000
  },
  "successMessage": "IATA synchronization completed. Updated records were verified and remaining mismatches were retried once.",
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/distribution-center/?per_page=1000",
      "active": true,
      "progress": "Loading Distribution Centers…"
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "progress": "Checking LG authentication…"
    },
    {
      "action": "waitFor",
      "selector": "table",
      "timeoutMs": 30000,
      "progress": "Waiting for Distribution Centers…"
    },
    {
      "action": "extractPaginatedTable",
      "storeAs": "distributionCenters",
      "makeCurrent": false,
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 30000,
      "stableMs": 1800,
      "pollMs": 450,
      "afterPageMs": 900,
      "dedupe": true,
      "maxPages": 1000,
      "pageProgress": "Reading Distribution Centers page {{page}}…",
      "progress": "Extracting Distribution Centers…"
    },
    {
      "action": "navigate",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "url": "https://drop-shipping.digikala.com/shipping-points/?id=&title=&from_created_at=&to_created_at=&created_by_id=0&type=&active=&cash_on_delivery=&per_page=1000&crud_tab_id=",
      "progress": "Opening Shipping Points…"
    },
    {
      "action": "ensureLogin",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "detectTimeoutMs": 7000,
      "progress": "Checking Drop Shipping authentication…"
    },
    {
      "action": "waitFor",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "selector": "table",
      "timeoutMs": 30000,
      "progress": "Waiting for Shipping Points…"
    },
    {
      "action": "ensureTableColumn",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "column": "code",
      "required": true,
      "attempts": 3,
      "retryDelayMs": 1200,
      "progress": "Ensuring Shipping Point code column…",
      "retryProgress": "Retrying Shipping Point code column ({{attempt}}/{{attempts}})…",
      "error": "Shipping Point code column did not load after 3 attempts.",
      "options": {
        "tableSelector": "table",
        "headerSelector": "table thead th",
        "buttonSelector": "button",
        "buttonText": "Columns",
        "checkboxSelector": "ul#adminColumns input[type=\"checkbox\"]",
        "menuTimeoutMs": 10000,
        "afterOpenMs": 1000,
        "afterSelectMs": 250,
        "loadTimeoutMs": 30000,
        "pollMs": 250
      },
      "stepAttempts": 1
    },
    {
      "action": "extractPaginatedTable",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "storeAs": "shippingPoints",
      "makeCurrent": false,
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 30000,
      "stableMs": 2200,
      "pollMs": 450,
      "afterPageMs": 1000,
      "dedupe": true,
      "maxPages": 1000,
      "pageProgress": "Reading Shipping Points page {{page}}…",
      "progress": "Extracting Shipping Points…"
    },
    {
      "action": "reconcileCodeByName",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "masterDataset": "distributionCenters",
      "masterNameAliases": [
        "name",
        "distribution center name",
        "dc name"
      ],
      "masterCodeAliases": [
        "iata",
        "iata code"
      ],
      "sources": [
        {
          "dataset": "shippingPoints",
          "type": "shipping-point",
          "nameAliases": [
            "title fa",
            "title_fa",
            "title",
            "name",
            "shipping point",
            "shipping point name"
          ],
          "idAliases": [
            "id"
          ],
          "codeAliases": [
            "code"
          ],
          "excludeIds": "{{pointExceptions}}"
        }
      ],
      "storeAs": "shippingPointCorrections",
      "makeCurrent": false,
      "resultMessage": "Shipping Points: found {{mismatchCount}} IATA mismatches.",
      "progress": "Comparing Shipping Point IATA codes…"
    },
    {
      "action": "applyFieldCorrections",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "continueOnError": true,
      "itemProgress": "Processing Shipping Point {{id}} ({{index}}/{{count}})…",
      "sources": {
        "shipping-point": {
          "listUrl": "https://drop-shipping.digikala.com/shipping-points/",
          "searchSelector": "input[name=\"id\"]",
          "tableSelector": "#tableForm tbody tr",
          "rowSelector": "#tableForm tbody tr",
          "detailsSelector": "a.uk-button.uk-button-success[href*=\"/shipping-points/item/\"]",
          "detailsText": "details",
          "codeSelector": "input[name=\"code\"]",
          "saveSelector": "button.admin-submit-button",
          "saveText": "save",
          "afterOpenMs": 800,
          "afterSearchMs": 1400,
          "beforeSaveMs": 0,
          "afterSaveMs": 900,
          "saveNavigationTimeoutMs": 15000,
          "searchTimeoutMs": 15000,
          "resultsTimeoutMs": 20000,
          "detailsTimeoutMs": 15000,
          "loginDetectTimeoutMs": 4000
        }
      },
      "progress": "Updating Shipping Point IATA corrections…"
    },
    {
      "action": "navigate",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "url": "https://drop-shipping.digikala.com/shipping-points/?id=&title=&from_created_at=&to_created_at=&created_by_id=0&type=&active=&cash_on_delivery=&per_page=1000&crud_tab_id=",
      "progress": "Verifying Shipping Point IATA updates…"
    },
    {
      "action": "ensureLogin",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "detectTimeoutMs": 7000,
      "progress": "Checking Drop Shipping authentication…"
    },
    {
      "action": "waitFor",
      "when": {
        "left": "{{syncTargets}}",
        "operator": "contains",
        "right": "shipping-points"
      },
      "selector": "table",
