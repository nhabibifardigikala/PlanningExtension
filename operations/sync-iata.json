      "retryProgress": "Retrying Shipping Point code column ({{attempt}}/{{attempts}})…",
      "error": "Shipping Point code column did not load after 3 attempts.",
      "options": {
        "tableSelector": "table",
        "headerSelector": "table thead th",
        "buttonSelector": "button",
        "buttonText": "Columns",
        "checkboxSelector": "ul#adminColumns input[type=\"checkbox\"]",
        "menuTimeoutMs": 10000,
        "afterOpenMs": 1000,
        "afterSelectMs": 250,
        "loadTimeoutMs": 30000,
