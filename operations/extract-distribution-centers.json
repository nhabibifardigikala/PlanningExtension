{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Extract all Distribution Center rows and prepare a single Excel file for download.",
  "inputs": [
    {
      "name": "__extractPage",
      "label": "Extraction",
      "type": "checkbox",
      "defaultChecked": false,
      "help": ""
    }
  ],
  "navigation": {
    "retryCount": 10,
    "retryDelayMs": 400,
    "completeTimeoutMs": 30000
  },
  "successMessage": "Extraction completed. {{rowCount}} rows are ready.",
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/distribution-center/?per_page=1000",
      "progress": "Opening Distribution Centers…",
      "active": true
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "progress": "Checking authentication…"
    },
    {
      "action": "waitFor",
      "selector": "table",
      "timeoutMs": 30000,
      "intervalMs": 300,
      "progress": "Waiting for Distribution Center table…",
      "error": "Distribution Center table was not found."
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 30000,
      "stableMs": 2500,
      "pollMs": 500,
      "afterPageMs": 700,
      "dedupe": true,
      "maxPages": 1000,
      "pageProgress": "Extracting Distribution Center page {{page}}…",
      "progress": "Extracting Distribution Centers…"
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 1500
  },
  "uiMode": "form",
  "runLabel": "Run Extraction",
  "clientProcessor": {
    "type": "data-pipeline",
    "source": {
      "type": "remote-operation",
      "operationId": "extract-dc",
      "inputs": {},
      "status": "Extracting Distribution Centers…"
    },
    "groups": [],
    "metrics": [],
    "charts": [],
    "presentation": {
      "partitionTitle": "Distribution Centers",
      "partitionSubtitle": "",
      "dashboardButtonLabel": "Open dashboard",
      "downloadButtonLabel": "Download Excel"
    },
    "export": {
      "enabled": true,
      "type": "xlsx",
      "buttonLabel": "Download Excel",
      "filename": "distribution_centers.xlsx",
      "sheetName": "Distribution Centers",
      "saveAs": false,
      "prependColumns": []
    }
  },
  "remoteBehaviorVersion": 2
}
