{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Run the Distribution Center extraction with 20% page zoom, exact column selection, full-page waits and manual Excel download.",
  "inputs": [
    {
      "name": "_openPage",
      "label": "",
      "type": "text",
      "showWhen": {
        "field": "__never__",
        "equals": "true"
      }
    }
  ],
  "navigation": {
    "retryCount": 10,
    "retryDelayMs": 500,
    "completeTimeoutMs": 60000
  },
  "successMessage": "Extraction completed. {{rowCount}} rows are ready.",
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/distribution-center/?per_page=1000",
      "progress": "Opening Distribution Centers…",
      "active": true
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 15000,
      "progress": "Checking authentication…"
    },
    {
      "action": "navigate",
      "url": "https://lg.digikala.com/distribution-center/?per_page=1000",
      "progress": "Opening Distribution Center list…",
      "completeTimeoutMs": 60000
    },
    {
      "action": "waitFor",
      "selector": "table",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "progress": "Waiting for Distribution Center table…",
      "error": "Distribution Center table was not found."
    },
    {
      "action": "setPageZoom",
      "zoom": 0.2,
      "progress": "Setting page zoom to 20%…"
    },
    {
      "action": "click",
      "selector": "button",
      "textContains": "Columns",
      "progress": "Opening Columns…",
      "afterMs": 1000,
      "error": "Columns button was not found."
    },
    {
      "action": "waitFor",
      "selector": "ul#adminColumns input[type=\"checkbox\"]",
      "timeoutMs": 12000,
      "intervalMs": 150,
      "progress": "Loading column settings…",
      "error": "Column settings did not open."
    },
    {
      "action": "setChecked",
      "selector": "ul#adminColumns input[type=\"checkbox\"][value=\"id\"]",
      "checked": true,
      "progress": "Configuring Distribution Center columns…",
      "stepAttempts": 3,
      "stepRetryDelayMs": 350,
      "afterMs": 50,
      "error": "Could not configure column: id"
    },
    {
      "action": "setChecked",
      "selector": "ul#adminColumns input[type=\"checkbox\"][value=\"name\"]",
      "checked": true,
