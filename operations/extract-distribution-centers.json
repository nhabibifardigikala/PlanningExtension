{
  "enabled": true,
  "handler": "generic",
  "requiresCredentials": true,
  "description": "Assign 100 Distribution Centers to the configured user, extract the required Distribution Center columns with 1000 rows per page, and replace DataSets → Distribution Centers (LG).",
  "inputs": [
    {
      "name": "useConfiguredEmail",
      "label": "",
      "type": "checkbox",
      "defaultChecked": true,
      "showWhen": {
        "field": "__never__",
        "equals": "true"
      }
    },
    {
      "name": "email",
      "label": "",
      "type": "text",
      "showWhen": {
        "field": "__never__",
        "equals": "true"
      }
    }
  ],
  "navigation": {
    "retryCount": 8,
    "retryDelayMs": 500,
    "completeTimeoutMs": 60000
  },
  "successMessage": "Distribution Centers extraction completed and Google Sheet updated successfully.",
  "workflow": [
    {
      "action": "open",
      "url": "https://lg.digikala.com/dc-user/item/0/?_back=https://lg.digikala.com/dc-user/",
      "progress": "Opening DC User Assignment…",
      "active": true
    },
    {
      "action": "ensureLogin",
      "detectTimeoutMs": 5000,
      "progress": "Checking authentication…"
    },
    {
      "action": "wait",
      "ms": 2500,
      "progress": "Keeping DC User Assignment active while the page settles…"
    },
    {
      "action": "waitFor",
      "selector": "input.uk-select.es-input[autocomplete=\"off\"][placeholder=\"\"]",
      "timeoutMs": 20000,
      "intervalMs": 250,
      "progress": "Waiting for DC User email field…",
      "error": "DC User email field was not found.",
      "_v415EmailPrefill": true
    },
    {
      "action": "autocomplete",
      "selector": "input.uk-select.es-input[autocomplete=\"off\"][placeholder=\"\"]",
      "selectorIndex": 0,
      "value": "{{email}}",
      "attempts": 5,
      "verifyNonEmpty": true,
      "options": {
        "selectorIndex": 0,
        "focusWaitMs": 400,
        "clearWaitMs": 250,
        "typingDelayMs": 110,
        "autocompleteWaitMs": 1800,
        "pressEnter": true,
        "keyDelayMs": 80,
        "commitWaitMs": 1200,
        "outsideSelector": "button.form-save-button.admin-submit-button",
        "outsideWaitMs": 500
      },
      "progress": "Entering configured user email…",
      "error": "Could not enter the configured user email in DC User Assignment.",
      "_v415EmailPrefill": true
    },
    {
      "action": "pagedBatchSubmit",
      "count": "100",
      "itemsPerPage": 20,
      "pagesPerBatch": 15,
      "resetUrl": "https://lg.digikala.com/dc-user/item/0/?_back=https://lg.digikala.com/dc-user/",
      "openerSelector": "a.chooseItemLink[title=\"click to choose\"], a.chooseItemLink",
      "openerTimeoutMs": 20000,
      "afterOpenMs": 1000,
      "selectAllSelector": "#admin-dynamic-clear-all",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "chooseSelector": "button.admin-dynamic-choose[data-action-type=\"choose\"]",
      "frameTimeoutMs": 20000,
      "nextTimeoutMs": 7000,
      "chooseTimeoutMs": 15000,
      "afterSelectMs": 700,
      "afterNextMs": 1400,
      "afterChooseMs": 1000,
      "batchProgress": "Assigning 100 DCs — batch {{batch}} of {{batches}}…",
      "skipProgress": "Moving to DC page {{page}}…",
      "pageProgress": "Selecting DC page {{page}} of {{pages}}…",
      "autocomplete": {
        "selector": "input.uk-select.es-input[autocomplete=\"off\"][placeholder=\"\"]",
        "value": "{{email}}",
        "attempts": 5,
        "verifyNonEmpty": true,
        "retryDelayMs": 600,
        "error": "Could not set the user email.",
        "options": {
          "typingDelayMs": 110,
          "autocompleteWaitMs": 1800,
          "pressEnter": true,
          "commitWaitMs": 1200,
          "outsideSelector": "button.form-save-button.admin-submit-button",
          "outsideWaitMs": 700,
          "selectorIndex": 0
        }
      },
      "beforeSubmitMs": 700,
      "submit": {
        "selector": "button.form-save-button.admin-submit-button",
        "textContains": "save",
        "error": "Save button was not found.",
        "acceptNavigation": true,
        "navigationGraceMs": 10000,
        "navigationCheckIntervalMs": 250
      },
      "outcomeTimeoutMs": 30000,
      "outcomeIntervalMs": 250,
      "afterSubmitMs": 1500,
      "progress": "Assigning the first 100 Distribution Centers…",
      "terminalMatchBehavior": "continue",
      "terminalSuccessMessage": "DC assignment is already present; continuing with extraction.",
      "terminalSuccessTexts": [
        "0 - User and DC relation already exists",
        "User and DC relation already exists"
      ]
    },
    {
      "action": "navigate",
      "url": "https://lg.digikala.com/distribution-center/?per_page=1000",
      "progress": "Opening Distribution Center list…",
      "completeTimeoutMs": 60000,
      "active": true
    },
    {
      "action": "wait",
      "ms": 16000,
      "progress": "Keeping Distribution Centers active while the page loads…"
    },
    {
      "action": "waitFor",
      "selector": "table",
      "timeoutMs": 5000,
      "intervalMs": 250,
      "progress": "Waiting for table…",
      "error": "Distribution Center table was not found.",
      "stepAttempts": 6,
      "stepRetryDelayMs": 750
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 12000,
      "intervalMs": 300,
      "progress": "Waiting for rows…",
      "error": "Distribution Center rows were not available.",
      "stepAttempts": 4,
      "stepRetryDelayMs": 900
    },
    {
      "action": "setPageZoom",
      "zoom": 0.2,
      "progress": "Preparing page…"
    },
    {
      "action": "configureColumns",
      "columns": {
        "id": 1,
        "name": 1,
        "city": 1,
        "iata": 1,
        "vehicle_types": 0,
        "district": 1,
        "active": 1,
        "has_fresh": 1,
        "sort": 1,
        "is_in_person": 1,
        "is_large": 1,
        "critical_time": 1,
        "is_suburbs": 1,
        "parent_dc_id": 1,
        "postal_code": 0,
        "is_drop_shipping_active": 1,
        "is_ganje": 1,
        "is_jet": 1,
        "is_third_party": 1,
        "child_dc_ids": 1,
        "hash_id": 1,
        "reference_id": 1,
        "address": 0,
        "alt_submit_type": 0,
        "capacity": 0,
        "city_id": 0,
        "city_id--preview": 0,
        "description": 0,
        "direct": 0,
        "distribution_center_district": 0,
        "distribution_center_district--preview": 0,
        "fmcg_warehouse_location_id": 0,
        "fmcg_warehouse_location_id--preview": 0,
        "has_time_scope": 0,
        "iata_code": 0,
        "is_deleted": 0,
        "is_dms_active": 0,
        "latitude": 0,
        "longitude": 0,
        "marketplace_seller_id": 0,
        "marketplace_seller_id--preview": 0,
        "non_fmcg_warehouse_location_id": 0,
        "non_fmcg_warehouse_location_id--preview": 0,
        "parent_dc_id--preview": 0,
        "payment_source_id": 0,
        "payment_source_id--preview": 0,
        "picking_time_limitation": 0,
        "prime_capacity_percentage": 0,
        "provider_reference": 0,
        "sla_from": 0,
        "sla_to": 0,
        "state_id": 0,
        "state_id--preview": 0,
        "virtual": 0
      },
      "options": {
        "buttonSelector": "button",
        "buttonText": "Columns",
        "checkboxSelector": "ul#adminColumns input[type=\"checkbox\"]",
        "menuTimeoutMs": 12000,
        "afterEachMs": 50,
        "closeAfter": false
      },
      "progress": "Preparing table columns…",
      "error": "Could not prepare the Distribution Center table."
    },
    {
      "action": "clickOutside",
      "center": true,
      "progress": "Applying table settings…"
    },
    {
      "action": "wait",
      "ms": 10000,
      "progress": "Waiting for table update…"
    },
    {
      "action": "navigate",
      "url": "https://lg.digikala.com/distribution-center/?per_page=1000",
      "progress": "Refreshing Distribution Center data…",
      "completeTimeoutMs": 60000,
      "active": true
    },
    {
      "action": "wait",
      "ms": 16000,
      "progress": "Keeping refreshed Distribution Centers active while data loads…"
    },
    {
      "action": "waitFor",
      "selector": "table",
      "timeoutMs": 5000,
      "intervalMs": 250,
      "progress": "Waiting for refreshed table…",
      "error": "Distribution Center table was not available after refresh.",
      "stepAttempts": 6,
      "stepRetryDelayMs": 750
    },
    {
      "action": "waitFor",
      "selector": "table tbody tr",
      "timeoutMs": 12000,
      "intervalMs": 300,
      "progress": "Waiting for refreshed rows…",
      "error": "Distribution Center rows were not available after refresh.",
      "stepAttempts": 4,
      "stepRetryDelayMs": 900
    },
    {
      "action": "setPageZoom",
      "zoom": 0.2,
      "progress": "Preparing refreshed page…"
    },
    {
      "action": "wait",
      "ms": 18000,
      "progress": "Waiting for data to finish loading…"
    },
    {
      "action": "extractPaginatedTable",
      "nextSelector": "a[aria-label=\"Next page\"]",
      "timeoutMs": 90000,
      "expectedRowsPerPage": 1000,
      "allowLastPagePartial": true,
      "pollMs": 2000,
      "afterPageMs": 500,
      "dedupe": false,
      "maxPages": 1000,
      "ignoreLastActionColumn": true,
      "parser": {
        "tableSelector": "table",
        "svgBoolean": true
      },
      "pageProgress": "Extracting Distribution Center page {{page}}…",
      "progress": "Extracting Distribution Centers…",
      "error": "No Distribution Center rows were found."
    },
    {
      "action": "closeTab",
      "progress": "Closing Agent tab…"
    }
  ],
  "retryPolicy": {
    "attempts": 3,
    "delayMs": 1500
  },
  "uiMode": "form",
  "runLabel": "Run Extraction",
  "clientProcessor": {
    "type": "data-pipeline",
    "source": {
      "type": "remote-operation",
      "operationId": "extract-dc",
      "inputs": {},
      "status": "Assigning DCs and extracting Distribution Centers…"
    },
    "groups": [],
    "metrics": [],
    "charts": [],
    "presentation": {
      "partitionTitle": "Distribution Centers",
      "partitionSubtitle": "",
      "dashboardButtonLabel": "Open dashboard",
      "downloadButtonLabel": "",
      "hideDashboardButton": true
    },
    "export": {
      "enabled": false
    },
    "publish": {
      "enabled": true,
      "webAppUrl": "https://script.google.com/macros/s/AKfycbyEJOsDh6uIsypeg0DxQKRffFguskutZ05aP7o44jygV7ZAlCrVUkX2eA3__WYmc0WNGg/exec",
      "action": "replaceDataset",
      "sheetName": "Distribution Centers (LG)",
      "status": "Publishing Distribution Centers to Google Sheet…"
    }
  },
  "remoteBehaviorVersion": 12,
  "runtimeContract": "stable-host-12",
  "businessLogicOwner": "remote",
  "keepTabActive": true,
  "foregroundReason": "LG defers table rendering in background tabs. DC User Assignment and Distribution Centers are both kept in the foreground during critical loading and selection windows through remote configuration.",
  "output": {
    "type": "sheet"
  },
  "closeTabOnError": true,
  "inputRules": [
    {
      "when": {
        "field": "useConfiguredEmail",
        "equals": true
      },
      "target": "email",
      "source": "credentialUsername"
    }
  ]
}
